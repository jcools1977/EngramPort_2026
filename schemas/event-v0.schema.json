{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engramport.com/schemas/event-v0.schema.json",
  "title": "EngramPort Git Event v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "thread", "from", "type", "occurred_at", "in_reply_to", "next", "content_sha256"],
  "properties": {
    "schema_version": { "const": 0 },
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "thread": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "from": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "type": { "enum": ["message", "handoff", "reply", "completion", "artifact", "decision", "task", "acknowledgment"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "in_reply_to": { "type": ["string", "null"] },
    "next": { "type": ["string", "null"] },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "thread_config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifacts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
