{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://engramport.dev/schemas/workspace-setup-v0.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","created_at","founder","repository","database","participants","groups","import","welcome"],
  "properties":{
    "schema_version":{"const":0},"created_at":{"type":"string","format":"date-time"},
    "founder":{"$ref":"#/$defs/founder"},"repository":{"$ref":"#/$defs/repository"},"database":{"$ref":"#/$defs/database"},
    "participants":{"type":"array","items":{"$ref":"#/$defs/participant"}},"groups":{"type":"array","items":{"$ref":"#/$defs/group"}},
    "import":{"$ref":"#/$defs/import"},"welcome":{"$ref":"#/$defs/welcome"}
  },
  "$defs":{
    "deps":{"type":"array","items":{"type":"string"},"default":[]},
    "founder":{"type":"object","additionalProperties":false,"required":["principal_id","scopes","assignable_trust","expires_at"],"properties":{"principal_id":{"type":"string"},"scopes":{"type":"array","items":{"type":"string"}},"assignable_trust":{"type":"array","items":{"enum":["system","verified_human","trusted_service","trusted_agent","untrusted_agent","imported"]}},"expires_at":{"type":["string","null"]}}},
    "repository":{"type":"object","additionalProperties":false,"required":["provider","owner","name","default_branch","permissions","depends_on"],"properties":{"provider":{"const":"github"},"owner":{"type":"string"},"name":{"type":"string"},"default_branch":{"type":"string"},"permissions":{"type":"array","items":{"type":"string"}},"depends_on":{"$ref":"#/$defs/deps"}}},
    "database":{"type":"object","additionalProperties":false,"required":["mode","target","depends_on"],"properties":{"mode":{"enum":["connect_existing","provision_managed"]},"target":{"type":"string"},"depends_on":{"$ref":"#/$defs/deps"}}},
    "participant":{"type":"object","additionalProperties":false,"required":["id","kind","role","scopes","capabilities","groups","trust","projects","expires_at","owner_id","depends_on"],"properties":{"id":{"type":"string"},"kind":{"enum":["human","guest","agent"]},"role":{"type":"string"},"scopes":{"type":"array","items":{"type":"string"}},"capabilities":{"type":"array","items":{"type":"string"}},"groups":{"type":"array","items":{"type":"string"}},"trust":{"type":"string"},"projects":{"type":"array","items":{"type":"string"}},"expires_at":{"type":["string","null"]},"owner_id":{"type":["string","null"]},"depends_on":{"$ref":"#/$defs/deps"}}},
    "group":{"type":"object","additionalProperties":false,"required":["name","members","depends_on"],"properties":{"name":{"type":"string"},"members":{"type":"array","items":{"type":"string"}},"depends_on":{"$ref":"#/$defs/deps"}}},
    "import":{"type":"object","additionalProperties":false,"required":["paths","include_history","depends_on"],"properties":{"paths":{"type":"array","items":{"type":"string"}},"include_history":{"type":"boolean"},"depends_on":{"$ref":"#/$defs/deps"}}},
    "welcome":{"type":"object","additionalProperties":false,"required":["expiry_days","depends_on"],"properties":{"expiry_days":{"type":"integer","minimum":1},"depends_on":{"$ref":"#/$defs/deps"}}}
  }
}
