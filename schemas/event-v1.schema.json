{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engramport.local/schemas/event-v1.schema.json",
  "title": "EngramPort Git event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "thread", "from", "type", "occurred_at", "in_reply_to", "next", "content_sha256", "intent_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "thread": { "$ref": "#/$defs/slug" },
    "from": { "$ref": "#/$defs/slug" },
    "type": { "enum": ["message", "handoff", "reply", "completion", "artifact", "decision", "task", "acknowledgment"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "in_reply_to": { "type": ["string", "null"] },
    "next": { "anyOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
    "content_sha256": { "$ref": "#/$defs/sha256" },
    "intent_sha256": { "$ref": "#/$defs/sha256" },
    "thread_config_sha256": { "$ref": "#/$defs/sha256" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "bounded_context": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/reference" } },
    "completion_criteria": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/criterion" } },
    "criteria_results": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/result" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "criterion_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "event_id"], "properties": { "type": { "const": "event" }, "event_id": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "ref"], "properties": { "type": { "const": "artifact" }, "ref": { "type": "string" } } }
      ]
    },
    "criterion": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "evidence_classes"],
      "properties": {
        "id": { "$ref": "#/$defs/criterion_id" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "evidence_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["event", "artifact"] } }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["criterion_id", "status", "evidence"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/criterion_id" },
        "status": { "const": "satisfied" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/reference" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "handoff" } }, "required": ["type"] },
      "then": { "required": ["bounded_context", "completion_criteria"], "not": { "required": ["criteria_results"] } }
    },
    {
      "if": { "properties": { "type": { "const": "completion" } }, "required": ["type"] },
      "then": { "not": { "anyOf": [{ "required": ["bounded_context"] }, { "required": ["completion_criteria"] }] } }
    }
  ]
}
