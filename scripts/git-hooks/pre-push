#!/usr/bin/env bash
# Delegate here from the installed pre-push hook. No network operations.
set -euo pipefail

signers="$(git config --path --get gpg.ssh.allowedSignersFile || true)"
if [[ ! -f "$signers" ]]; then
  signers="$HOME/.ssh/engramport_allowed_signers"
fi
if [[ ! -f "$signers" ]]; then
  echo 'pre-push: refusing: no allowed-signers file at the configured path or ~/.ssh/engramport_allowed_signers' >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
record=''
if [[ -f "$root/docs/security/accepted-identity-mismatches.json" ]]; then
  record="$(< "$root/docs/security/accepted-identity-mismatches.json")"
fi
refused=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a ref sends no commits.
  [[ "$local_sha" =~ ^0+$ ]] && continue
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    commits="$(git rev-list "$local_sha" --not --remotes)"
  else
    commits="$(git rev-list "$remote_sha..$local_sha")"
  fi
  while IFS= read -r commit; do
    [[ -z "$commit" ]] && continue
    observation="$(git -c "gpg.ssh.allowedSignersFile=$signers" show -s '--format=%H|%G?|%ae|%GS' "$commit")"
    IFS='|' read -r sha status author signer <<< "$observation"
    # The existing identity control validates the record's full schema and facts.
    # Here only an exact SHA field in that record grants the historical exception.
    accepted_pattern='"sha"[[:space:]]*:[[:space:]]*"'"$sha"'"'
    if [[ "$status" != G || "$author" != "$signer" ]]; then
      if [[ ! "$record" =~ $accepted_pattern ]]; then
        echo "pre-push: refusing $sha author=$author signer=${signer:-<none>} signature=$status" >&2
        refused=1
      fi
    fi
  done <<< "$commits"
done
exit "$refused"
