#!/usr/bin/env node
import { runAgentCReview } from "../packages/agent-c-supervisor/src/index.mjs";

function options(argv) {
  const result = { context: [] };
  for (let index = 0; index < argv.length; index += 1) {
    if (argv[index] === "--event") result.event = argv[++index];
    else if (argv[index] === "--context") result.context.push(argv[++index]);
    else throw new Error("ARGUMENT_REFUSED");
  }
  return result;
}

try {
  const parsed = options(process.argv.slice(2));
  if (!parsed.event) throw new Error("EVENT_REQUIRED");
  const result = await runAgentCReview({ targetRelative: parsed.event, contextPaths: parsed.context });
  console.log(`agent-c review appended; measurement=${result.artifact.relative}#sha256=${result.artifact.sha256}`);
} catch (error) {
  console.error(`agent-c supervisor: ${error.code ?? error.message ?? "REFUSED"}`);
  process.exitCode = 1;
}
