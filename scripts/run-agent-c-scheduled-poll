#!/usr/bin/env node
import { appendFile, mkdir, readFile, rename, stat, writeFile } from "node:fs/promises";
import os from "node:os";
import path from "node:path";
import { spawn } from "node:child_process";
import { pollAgentCInbox, processScheduledAgentCPoll } from "../packages/agent-c-supervisor/src/index.mjs";

const root = path.resolve(import.meta.dirname, "..");
const stateDirectory = path.join(os.homedir(), ".local", "state", "an2b", "engramport-agent-c");
const logFile = path.join(stateDirectory, "poll.log");
const seenFile = path.join(stateDirectory, "last-actionable.sha256");
const maxLogBytes = 262_144;

async function boundedLog(message) {
  await mkdir(stateDirectory, { recursive: true, mode: 0o700 });
  const size = await stat(logFile).then((entry) => entry.size, () => 0);
  if (size > maxLogBytes) {
    const content = await readFile(logFile);
    await writeFile(logFile, content.subarray(content.length - maxLogBytes / 2), { mode: 0o600 });
  }
  await appendFile(logFile, `${new Date().toISOString()} ${message}\n`, { mode: 0o600 });
}

async function notify(message) {
  await new Promise((resolve) => {
    const child = spawn("/usr/bin/osascript", ["-e", `display notification ${JSON.stringify(message)} with title "EngramPort Agent C"`], { stdio: "ignore" });
    child.once("error", resolve);
    child.once("close", resolve);
  });
}

async function readSeen() {
  try { return (await readFile(seenFile, "utf8")).trim(); }
  catch (error) { if (error.code === "ENOENT") return ""; throw error; }
}

async function writeSeen(signature) {
  await mkdir(stateDirectory, { recursive: true, mode: 0o700 });
  const temporary = `${seenFile}.${process.pid}.tmp`;
  await writeFile(temporary, `${signature}\n`, { mode: 0o600 });
  await rename(temporary, seenFile);
}

try {
  const result = await processScheduledAgentCPoll({
    poll: () => pollAgentCInbox({ root }),
    readSeen,
    writeSeen,
    log: boundedLog,
    notify
  });
  if (result.status === "failed") process.exitCode = 1;
} catch {
  await boundedLog("ERROR SCHEDULED_POLLER_FAILED").catch(() => undefined);
  await notify("Agent C scheduled poller failed before completing its check.").catch(() => undefined);
  process.exitCode = 1;
}
