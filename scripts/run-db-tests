#!/usr/bin/env bash
set -euo pipefail
root_dir="$(cd "$(dirname "$0")/.." && pwd)"
compose=(docker compose -f "$root_dir/deploy/docker-compose.yml")
cleanup() { "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true; }
trap cleanup EXIT
cleanup
"${compose[@]}" up -d --wait
db=("${compose[@]}" exec -T postgres psql -v ON_ERROR_STOP=1)
checksum="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0001_canonical_core.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0001_canonical_core.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0001_canonical_core', '$checksum');"
recorded_checksum="$("${db[@]}" -U engram_migrator -d engramport -Atc "SELECT checksum_sha256 FROM schema_migrations WHERE version='0001_canonical_core';")"
if [[ "$recorded_checksum" != "$checksum" ]]; then
  echo "migration checksum mismatch: expected $checksum, recorded $recorded_checksum" >&2
  exit 1
fi
echo "migration checksum verified: $recorded_checksum"
checksum2="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0002_durable_custody.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0002_durable_custody.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0002_durable_custody', '$checksum2');"
"${db[@]}" -U postgres -d engramport -c "DO \$\$ BEGIN IF NOT (SELECT relforcerowsecurity FROM pg_class WHERE oid='custody_rows'::regclass) OR NOT (SELECT relforcerowsecurity FROM pg_class WHERE oid='minted_references'::regclass) OR NOT (SELECT relforcerowsecurity FROM pg_class WHERE oid='custody_audit'::regclass) THEN RAISE EXCEPTION 'custody tables must force RLS'; END IF; END \$\$;"
checksum3="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0003_durable_custody_correction.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0003_durable_custody_correction.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0003_durable_custody_correction', '$checksum3');"
checksum4="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0004_durable_custody_controls.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0004_durable_custody_controls.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0004_durable_custody_controls', '$checksum4');"
checksum5="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0005_d1e_authorization_derivation.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0005_d1e_authorization_derivation.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0005_d1e_authorization_derivation', '$checksum5');"
checksum6="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0006_d1e_model_derivation.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0006_d1e_model_derivation.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0006_d1e_model_derivation', '$checksum6');"
checksum7="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0007_d1e_auth_order_mapping.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0007_d1e_auth_order_mapping.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0007_d1e_auth_order_mapping', '$checksum7');"
checksum8="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0008_d1e_tenant_derivation.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0008_d1e_tenant_derivation.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0008_d1e_tenant_derivation', '$checksum8');"
checksum9="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0009_d1_acl_regression.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0009_d1_acl_regression.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0009_d1_acl_regression', '$checksum9');"
checksum10="$(node -e "const fs=require('fs'),c=require('crypto');process.stdout.write(c.createHash('sha256').update(fs.readFileSync(process.argv[1])).digest('hex'))" "$root_dir/migrations/0010_m13_class_gates.sql")"
"${db[@]}" -U engram_migrator -d engramport < "$root_dir/migrations/0010_m13_class_gates.sql"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO schema_migrations(version, checksum_sha256) VALUES ('0010_m13_class_gates', '$checksum10');"
"${db[@]}" -U postgres -d engramport -c "DO \$\$ BEGIN IF has_function_privilege('engram_app','derive_mint_membership(uuid)','EXECUTE') THEN RAISE EXCEPTION 'app must not execute derive helper'; END IF; IF NOT has_function_privilege('engram_maintenance','derive_mint_membership(uuid)','EXECUTE') THEN RAISE EXCEPTION 'maintenance must execute derive helper'; END IF; END \$\$;"
"${db[@]}" -U postgres -d engramport < "$root_dir/deploy/seed.sql"
"${db[@]}" -U postgres -d engramport < "$root_dir/tests/isolation/rls.sql"
"${db[@]}" -U postgres -d engramport < "$root_dir/tests/failure/app-role-grants.sql"
"${db[@]}" -U postgres -d engramport < "$root_dir/tests/failure/constraints.sql"
"${db[@]}" -U postgres -d engramport < "$root_dir/tests/failure/discrimination.sql"
"${db[@]}" -U postgres -d engramport < "$root_dir/tests/failure/d1-regression.sql"
"${db[@]}" -U postgres -d engramport -c "INSERT INTO founder_authorities(principal_id,scopes,expires_at) VALUES ('11000000-0000-0000-0000-000000000001',ARRAY['custody:mint:credential:3.3:B'],clock_timestamp()+interval '1 hour') ON CONFLICT(principal_id) DO UPDATE SET scopes=EXCLUDED.scopes,expires_at=EXCLUDED.expires_at;"
"${db[@]}" -U engram_migrator -d engramport -c "INSERT INTO credential_class_gates(credential_class,gate_id,passed,threat_revision,threat_digest) VALUES ('3.3','C3',true,8,'629ae3f2654aba46e4c1158fc234c6b24831a369505ccf41878af3207b091089') ON CONFLICT (credential_class) DO UPDATE SET passed=EXCLUDED.passed,threat_revision=EXCLUDED.threat_revision,threat_digest=EXCLUDED.threat_digest;"
"${db[@]}" -U engram_maintenance -d engramport < "$root_dir/tests/failure/m13-class-gate.sql"
"${db[@]}" -U postgres -d engramport < "$root_dir/tests/bootstrap/bootstrap.sql"
race_dir="$(mktemp -d)"
race_cleanup() { rm -rf "$race_dir"; }
trap 'race_cleanup; cleanup' EXIT
cat > "$race_dir/a.sql" <<'SQL'
\set ON_ERROR_STOP on
SELECT set_config('app.test_bootstrap_pause','true',false);
SELECT * FROM bootstrap_workspace('31000000-0000-0000-0000-000000000001','32000000-0000-0000-0000-000000000001','33000000-0000-0000-0000-000000000001','race-a','Race A');
SQL
cat > "$race_dir/b.sql" <<'SQL'
\set ON_ERROR_STOP on
SELECT set_config('app.test_bootstrap_pause','true',false);
SELECT * FROM bootstrap_workspace('31000000-0000-0000-0000-000000000001','32000000-0000-0000-0000-000000000002','33000000-0000-0000-0000-000000000002','race-b','Race B');
SQL
"${db[@]}" -U postgres -d engramport -c "INSERT INTO founder_authorities(principal_id,scopes,expires_at) VALUES ('31000000-0000-0000-0000-000000000001',ARRAY['setup:bootstrap'],clock_timestamp()+interval '1 hour');"
set +e
"${db[@]}" -U engram_maintenance -d engramport < "$race_dir/a.sql" >"$race_dir/a.out" 2>&1 & pid_a=$!
sleep 0.2
"${db[@]}" -U engram_maintenance -d engramport < "$race_dir/b.sql" >"$race_dir/b.out" 2>&1 & pid_b=$!
wait "$pid_a"; status_a=$?
wait "$pid_b"; status_b=$?
set -e
if [[ $status_a -eq 0 && $status_b -ne 0 ]] || [[ $status_b -eq 0 && $status_a -ne 0 ]]; then
  echo "PASS concurrent bootstrap exactly one winner (a=$status_a b=$status_b)"
else
  echo "concurrent bootstrap expected exactly one winner (a=$status_a b=$status_b)" >&2
  cat "$race_dir/a.out" "$race_dir/b.out" >&2
  exit 1
fi
if ! grep -q 'founder bootstrap already established' "$race_dir/a.out" "$race_dir/b.out"; then
  echo "concurrent bootstrap loser error was not deterministic" >&2; exit 1
fi
"${db[@]}" -U postgres -d engramport -c "DO \$\$
DECLARE n bigint;
BEGIN
 SELECT count(*) INTO n FROM tenants WHERE id='32000000-0000-0000-0000-000000000001'; IF n<>1 THEN RAISE EXCEPTION 'tenant residue assertion expected 1, got %',n; END IF;
 SELECT count(*) INTO n FROM projects WHERE id='33000000-0000-0000-0000-000000000001'; IF n<>1 THEN RAISE EXCEPTION 'project residue assertion expected 1, got %',n; END IF;
 SELECT count(*) INTO n FROM principals WHERE id='31000000-0000-0000-0000-000000000001'; IF n<>1 THEN RAISE EXCEPTION 'principal residue assertion expected 1, got %',n; END IF;
 SELECT count(*) INTO n FROM project_memberships WHERE project_id='33000000-0000-0000-0000-000000000001'; IF n<>1 THEN RAISE EXCEPTION 'membership residue assertion expected 1, got %',n; END IF;
 SELECT count(*) INTO n FROM bootstrap_establishments WHERE principal_id='31000000-0000-0000-0000-000000000001'; IF n<>1 THEN RAISE EXCEPTION 'establishment residue assertion expected 1, got %',n; END IF;
 SELECT count(*) INTO n FROM actor_delegations WHERE principal_id='31000000-0000-0000-0000-000000000001'; IF n<>0 THEN RAISE EXCEPTION 'delegation loser residue expected 0, got %',n; END IF;
 SELECT count(*) INTO n FROM agent_sessions WHERE project_id='33000000-0000-0000-0000-000000000001'; IF n<>0 THEN RAISE EXCEPTION 'session loser residue expected 0, got %',n; END IF;
 SELECT count(*) INTO n FROM events WHERE project_id='33000000-0000-0000-0000-000000000001'; IF n<>0 THEN RAISE EXCEPTION 'event/audit loser residue expected 0, got %',n; END IF;
 SELECT count(*) INTO n FROM actors WHERE project_id='33000000-0000-0000-0000-000000000001'; IF n<>0 THEN RAISE EXCEPTION 'actor loser residue expected 0, got %',n; END IF;
 SELECT count(*) INTO n FROM threads WHERE project_id='33000000-0000-0000-0000-000000000001'; IF n<>0 THEN RAISE EXCEPTION 'thread loser residue expected 0, got %',n; END IF;
 IF to_regclass('public.approvals') IS NOT NULL OR to_regclass('public.audit_records') IS NOT NULL THEN RAISE EXCEPTION 'untracked approval/audit tables present'; END IF;
 RAISE NOTICE 'PASS complete loser residue inventory: tenant, project, principal, membership, delegation, approval, session, establishment, event/audit, actor, and thread categories independently asserted';
END \$\$;"

# Discrimination: remove the complete set of colliding graph constraints in a
# fresh test database state. The production barrier and every fallback identity
# constraint are gone here; the same overlapping race must therefore yield two.
"${db[@]}" -U postgres -d engramport -c "ALTER TABLE bootstrap_establishments DROP CONSTRAINT bootstrap_establishments_pkey, DROP CONSTRAINT bootstrap_establishments_tenant_id_key, DROP CONSTRAINT bootstrap_establishments_project_id_key; ALTER TABLE principals DROP CONSTRAINT principals_pkey CASCADE; ALTER TABLE principals DROP CONSTRAINT principals_tenant_id_id_key CASCADE; ALTER TABLE tenants DROP CONSTRAINT tenants_pkey CASCADE; ALTER TABLE tenants DROP CONSTRAINT tenants_slug_key CASCADE; ALTER TABLE projects DROP CONSTRAINT projects_pkey CASCADE; ALTER TABLE projects DROP CONSTRAINT projects_tenant_id_slug_key CASCADE, DROP CONSTRAINT projects_tenant_id_id_key CASCADE; ALTER TABLE project_memberships DROP CONSTRAINT project_memberships_pkey; INSERT INTO founder_authorities(principal_id,scopes,expires_at) VALUES ('41000000-0000-0000-0000-000000000001',ARRAY['setup:bootstrap'],clock_timestamp()+interval '1 hour');"
cat > "$race_dir/c.sql" <<'SQL'
\set ON_ERROR_STOP on
SELECT set_config('app.test_bootstrap_pause','true',false);
SELECT * FROM bootstrap_workspace('41000000-0000-0000-0000-000000000001','42000000-0000-0000-0000-000000000001','43000000-0000-0000-0000-000000000001','weak-a','Weak A');
SQL
cat > "$race_dir/d.sql" <<'SQL'
\set ON_ERROR_STOP on
SELECT set_config('app.test_bootstrap_pause','true',false);
SELECT * FROM bootstrap_workspace('41000000-0000-0000-0000-000000000001','42000000-0000-0000-0000-000000000002','43000000-0000-0000-0000-000000000002','weak-b','Weak B');
SQL
set +e
"${db[@]}" -U engram_maintenance -d engramport < "$race_dir/c.sql" >"$race_dir/c.out" 2>&1 & pid_c=$!
sleep 0.2
"${db[@]}" -U engram_maintenance -d engramport < "$race_dir/d.sql" >"$race_dir/d.out" 2>&1 & pid_d=$!
wait "$pid_c"; status_c=$?
wait "$pid_d"; status_d=$?
set -e
if [[ $status_c -eq 0 && $status_d -eq 0 ]]; then
  echo "PASS weakened barrier discrimination produced two winners"
else
  echo "weakened barrier discrimination expected two winners (c=$status_c d=$status_d)" >&2
  cat "$race_dir/c.out" "$race_dir/d.out" >&2
  exit 1
fi
"${db[@]}" -U postgres -d engramport -Atc "SELECT version(); SELECT extversion FROM pg_extension WHERE extname='vector';"


\"${db[@]}\" -U engram_maintenance -d engramport < \"$root_dir/tests/failure/d1-behavioural.sql\"
"${db[@]}" -U engram_maintenance -d engramport < "$root_dir/tests/failure/d1-behavioural.sql"
