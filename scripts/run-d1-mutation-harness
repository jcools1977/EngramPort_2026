make_event_v1_variant(){
  local target="$1" mode="$2"
  mkdir -p "$target"
  cp -R "$root_dir/packages/git-adapter/src/." "$target/"
  node - "$target" "$mode" <<'NODE'
const fs=require("node:fs"),path=require("node:path");const [root,mode]=process.argv.slice(2);
const cliFile=path.join(root,"cli.mjs"),coreFile=path.join(root,"event-core.mjs"),verifyFile=path.join(root,"verify-log.mjs");
function mutate(file,anchor,replacement){let text=fs.readFileSync(file,"utf8");if(text.split(anchor).length-1!==1)throw new Error(`anchor not exact: ${anchor}`);text=text.replace(anchor,replacement);fs.writeFileSync(file,text);}
if(mode==="retry-match")mutate(coreFile,'    if (existing.event.meta.schema_version === 1 && existing.event.meta.intent_sha256 === intentSha256) return resultFor(existing.relative, id, true); /* V1_RETRY_INTENT_MATCH */','    if (false /* V1_RETRY_INTENT_MATCH_REMOVED */) return resultFor(existing.relative, id, true);');
else if(mode==="retry-collision")mutate(coreFile,'    if (existing.event.meta.schema_version === 1 && existing.event.meta.intent_sha256 === intentSha256) return resultFor(existing.relative, id, true); /* V1_RETRY_INTENT_MATCH */','    if (existing.event.meta.schema_version === 1 /* V1_RETRY_COLLISION_REMOVED */) return resultFor(existing.relative, id, true);');
else if(mode==="criteria-coverage")mutate(verifyFile,'    if (missing.length) errors.push(`${event.relative}: completion missing criterion ids ${missing.join(", ")}`); /* V1_CRITERIA_EXACT_COVERAGE */','    if (false /* V1_CRITERIA_EXACT_COVERAGE_REMOVED */) errors.push(`${event.relative}: completion missing criterion ids ${missing.join(", ")}`);');
else if(mode==="writer-cutover")mutate(coreFile,'  if (schemaVersion !== 1) throw appendError("EVENT_VERSION_REFUSED", "live append accepts schema_version 1 only"); /* V1_WRITER_CUTOVER */','  if (false /* V1_WRITER_CUTOVER_REMOVED */) throw appendError("EVENT_VERSION_REFUSED", "live append accepts schema_version 1 only");');
else if(mode==="terminal-next")mutate(cliFile,'    const next = options.next === "null" ? null : options.next; /* V1_CLI_TERMINAL_NEXT */','    const next = options.next; /* V1_CLI_TERMINAL_NEXT_REMOVED */');
else throw new Error(`unknown event-v1 variant ${mode}`);
NODE
}
make_port_watch_variant(){
  local target="$1" mode="$2"
  mkdir -p "$target/packages/git-adapter" "$target/packages/port-watch"
  cp -R "$root_dir/packages/git-adapter/src" "$target/packages/git-adapter/" || return 1
  cp -R "$root_dir/packages/port-watch/src" "$target/packages/port-watch/" || return 1
  node - "$target" "$mode" <<'NODE'
const fs=require("node:fs"),path=require("node:path");const [root,mode]=process.argv.slice(2);
const core=path.join(root,"packages/git-adapter/src/event-core.mjs"),watch=path.join(root,"packages/port-watch/src/index.mjs"),observation=path.join(root,"packages/port-watch/src/observation.mjs");
function mutate(file,anchor,replacement){let text=fs.readFileSync(file,"utf8");if(text.split(anchor).length-1!==1)throw new Error(`anchor not exact: ${anchor}`);text=text.replace(anchor,replacement);fs.writeFileSync(file,text);}
if(mode==="shared")mutate(core,'.filter(({ event }) => event.meta.next === actor && !answered.has(event.meta.id))','.filter(({ event }) => event.meta.next === actor /* PORT_WATCH_SHARED_ELIGIBILITY_REMOVED */)');
else if(mode==="position")mutate(watch,'    await this.claim_store.release(agent, project, { run_id });\n    await this.record({ kind: `run.${status}`, agent, project, run_id, event_id: claim.event_id, disposition: "reply_in_port_log" });','    await this.claim_store.release(agent, project, { run_id });\n    await this.store.transaction((state) => { state.agents[key(agent, project)].cursor = claim.event_id; return state; }); /* PORT_WATCH_LOG_DERIVED_POSITION_REMOVED */\n    await this.record({ kind: `run.${status}`, agent, project, run_id, event_id: claim.event_id, disposition: "reply_in_port_log" });');
else if(mode==="cache")mutate(watch,'    if (cached?.log_state === log_state && Array.isArray(cached.deliveries)) {','    if (cached && Array.isArray(cached.deliveries) /* PORT_WATCH_CACHE_LOG_STATE_REMOVED */) {');
else if(mode==="claim")mutate(watch,'    if (!reservation.acquired) {','    if (false && !reservation.acquired /* PORT_WATCH_ATOMIC_CLAIM_REMOVED */) {');
else if(mode==="legacy")mutate(watch,'  if (watch.active_run) throw new Error("LEGACY_ACTIVE_RUN_REQUIRES_RESOLUTION");','  if (false /* PORT_WATCH_LEGACY_ACTIVE_RUN_GUARD_REMOVED */) throw new Error("LEGACY_ACTIVE_RUN_REQUIRES_RESOLUTION");');
else if(mode==="observation-authority")mutate(observation,'    if (outcome?.claim_turn || outcome?.grant_authority || outcome?.scopes?.length) throw new Error("OBSERVATION_AUTHORITY_REFUSED"); /* OBSERVATION_NO_TURN_AUTHORITY */','    if (false /* OBSERVATION_NO_TURN_AUTHORITY_REMOVED */) throw new Error("OBSERVATION_AUTHORITY_REFUSED");');
else if(mode==="observation-canonical")mutate(observation,'canonicalBatchDigest(canonical) !== checkpoint.batch_digest','checkpoint.batch_digest !== checkpoint.batch_digest /* OBSERVATION_CANONICAL_RANGE_DIGEST_REMOVED */');
else if(mode==="observation-prior")mutate(observation,'(checkpoint.prior_checkpoint_digest ?? null) !== (previous?.checkpoint_digest ?? null)','false /* OBSERVATION_PRIOR_BODY_DIGEST_REMOVED */');
else if(mode==="observation-delivery")mutate(observation,'export function stableDeliveryId({ tenant_id, subscription_id, subscriber_id, selector_revision, covered_from, covered_to, batch_digest }) {\n  return digestFields(["observation-delivery-v1", tenant_id, subscription_id, subscriber_id, selector_revision, covered_from, covered_to, batch_digest]);\n}','export function stableDeliveryId() { return randomUUID(); /* OBSERVATION_STABLE_DELIVERY_DEDUP_REMOVED */ }');
else throw new Error(`unknown Port Watch variant ${mode}`);
NODE
}
