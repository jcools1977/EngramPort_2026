      PORT_WATCH_LOG_DERIVED_POSITION) mode=position; marker=PORT_WATCH_LOG_DERIVED_POSITION_REMOVED; test_pattern='completion stores no position and an unanswered work item remains eligible at least once'; suite=watch ;;
      PORT_WATCH_CACHE_LOG_STATE) mode=cache; marker=PORT_WATCH_CACHE_LOG_STATE_REMOVED; test_pattern='changed log state cannot reuse a stale cached work set'; suite=watch ;;
      PORT_WATCH_ATOMIC_CLAIM) mode=claim; marker=PORT_WATCH_ATOMIC_CLAIM_REMOVED; test_pattern='concurrent ticks reserve one invocation slot before either runner call'; suite=watch ;;
      PORT_WATCH_POSTGRES_EXCLUSIVITY) mode=postgres-claim; marker=PORT_WATCH_POSTGRES_EXCLUSIVITY_REMOVED; test_pattern='PostgreSQL claim store excludes duplicate invocation across independent connections'; suite=claim_live ;;
      PORT_WATCH_LEGACY_ACTIVE_RUN_GUARD) mode=legacy; marker=PORT_WATCH_LEGACY_ACTIVE_RUN_GUARD_REMOVED; test_pattern='legacy active run requires explicit expiry before log-derived migration'; suite=watch ;;
