    log="$mutation_dir/event-enumeration-alignment.log"
    GIT_ADAPTER_VERIFY_MODULE="$(agent_c_url "$variant")" node --test --test-reporter=tap --test-name-pattern="$test_pattern" "$root_dir/tests/git-v0.test.mjs" >"$log" 2>&1; after=$?
    forbidden=f; grep -Eq "not ok [0-9]+ - $test_pattern" "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
