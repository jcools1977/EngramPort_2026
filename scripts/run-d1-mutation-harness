const fs=require("node:fs"),path=require("node:path"),{pathToFileURL}=require("node:url");
const [source,target,root]=process.argv.slice(2);let text=fs.readFileSync(source,"utf8");
const anchor='  if (profile) for (const flag of Object.keys(out).filter((key) => key !== "_")) if (!profile.has(flag)) argumentRefused(flag);';
if(!text.includes(anchor))throw new Error(`anchor absent: ${anchor}`);
text=text.replace(anchor,'  void profile; /* CLI_ARGUMENT_REFUSAL_REMOVED */');
for(const name of ["verify-log.mjs","welcome-verify.mjs","workspace-setup.mjs","workspace-dry-run.mjs","credential-boundary.mjs","event-core.mjs"]){
  text=text.replaceAll(`"./${name}"`,JSON.stringify(pathToFileURL(path.join(root,"packages/git-adapter/src",name)).href));
}
fs.writeFileSync(target,text);
NODE
}
