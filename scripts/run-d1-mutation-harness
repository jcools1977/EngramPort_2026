  cp "$root_dir/packages/git-adapter/src/oidc-verifier.mjs" "$target" || return 1
  node - "$target" "$mode" <<'NODE'
const fs=require("node:fs");const [file,mode]=process.argv.slice(2);let text=fs.readFileSync(file,"utf8");
function replace(anchor,replacement){if(text.split(anchor).length-1!==1)throw new Error(`anchor not exact: ${anchor}`);text=text.replace(anchor,replacement);}
if(mode==="signature")replace('      if(!verifySignature("RSA-SHA256",signingInput,selected.key,signature))refuse("OIDC_SIGNATURE_REFUSED","signature verification failed");','      if(false /* W1_1_OIDC_SIGNATURE_REMOVED */)refuse("OIDC_SIGNATURE_REFUSED","signature verification failed");');
else if(mode==="rotation")replace('      if(selected.status!=="active")refuse("OIDC_KEY_RETIRED","retired signing key refused");','      if(false /* W1_1_OIDC_ROTATION_REMOVED */)refuse("OIDC_KEY_RETIRED","retired signing key refused");');
else if(mode==="alg-none"){
  replace('      if(header.alg==="none")refuse("OIDC_ALGORITHM_NONE_REFUSED","unsigned tokens are refused");','      if(false /* W1_1_OIDC_ALG_NONE_GUARD_REMOVED */)refuse("OIDC_ALGORITHM_NONE_REFUSED","unsigned tokens are refused");');
  replace('      if(header.alg!=="RS256")refuse("OIDC_ALGORITHM_CONFUSION_REFUSED","only RS256 is accepted");','      if(header.alg!=="RS256"&&header.alg!=="none" /* W1_1_OIDC_ALG_NONE_ALLOWLIST_REMOVED */)refuse("OIDC_ALGORITHM_CONFUSION_REFUSED","only RS256 is accepted");');
  replace('      if(!verifySignature("RSA-SHA256",signingInput,selected.key,signature))refuse("OIDC_SIGNATURE_REFUSED","signature verification failed");','      if(header.alg!=="none"&&!verifySignature("RSA-SHA256",signingInput,selected.key,signature) /* W1_1_OIDC_ALG_NONE_SIGNATURE_REMOVED */)refuse("OIDC_SIGNATURE_REFUSED","signature verification failed");');
}else if(mode==="alg-hs256"){
  replace('import { createPublicKey, verify as verifySignature } from "node:crypto";','import { createHmac, createPublicKey, timingSafeEqual, verify as verifySignature } from "node:crypto";');
  replace('      if(header.alg!=="RS256")refuse("OIDC_ALGORITHM_CONFUSION_REFUSED","only RS256 is accepted");','      if(header.alg!=="RS256"&&header.alg!=="HS256" /* W1_1_OIDC_ALG_HS256_ALLOWLIST_REMOVED */)refuse("OIDC_ALGORITHM_CONFUSION_REFUSED","only RS256 is accepted");');
  replace('      if(!verifySignature("RSA-SHA256",signingInput,selected.key,signature))refuse("OIDC_SIGNATURE_REFUSED","signature verification failed");','      const signatureValid=header.alg==="HS256"?timingSafeEqual(createHmac("sha256",selected.key.export({type:"spki",format:"pem"})).update(signingInput).digest(),signature):verifySignature("RSA-SHA256",signingInput,selected.key,signature);\n      if(!signatureValid /* W1_1_OIDC_ALG_HS256_KEY_CONFUSION */)refuse("OIDC_SIGNATURE_REFUSED","signature verification failed");');
}else if(mode==="issuer")replace('      if(payload.iss!==issuer)refuse("OIDC_ISSUER_REFUSED","issuer mismatch");','      if(false /* W1_1_OIDC_ISSUER_REMOVED */)refuse("OIDC_ISSUER_REFUSED","issuer mismatch");');
else if(mode==="audience")replace('      if(!exactAudience(payload.aud,audience))refuse("OIDC_AUDIENCE_REFUSED","audience mismatch");','      if(false /* W1_1_OIDC_AUDIENCE_REMOVED */)refuse("OIDC_AUDIENCE_REFUSED","audience mismatch");');
else if(mode==="expiry")replace('      if(!Number.isInteger(payload.exp)||payload.exp*1000<=clock().getTime())refuse("OIDC_EXPIRED","token expired");','      if(false /* W1_1_OIDC_EXPIRY_REMOVED */)refuse("OIDC_EXPIRED","token expired");');
else if(mode==="nonce")replace('      if(typeof nonce!=="string"||nonce.length===0||payload.nonce!==nonce)refuse("OIDC_NONCE_REFUSED","nonce mismatch");','      if(false /* W1_1_OIDC_NONCE_REMOVED */)refuse("OIDC_NONCE_REFUSED","nonce mismatch");');
else if(mode==="claims-surface")replace('      return freezeClaims(payload);','      return Object.freeze({...payload}); /* W1_1_OIDC_CLAIMS_SURFACE_REMOVED */');
else if(mode==="retention")replace('    }finally{inFlight.delete(transient);}','    }finally{void transient; /* W1_1_OIDC_RETENTION_CLEANUP_REMOVED */}');
