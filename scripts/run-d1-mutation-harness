  .replace('"./verify-log.mjs"',JSON.stringify(pathToFileURL(verifyTarget).href))
  .replace('"./credential-boundary.mjs"',JSON.stringify(pathToFileURL(path.join(root,"packages/git-adapter/src/credential-boundary.mjs")).href));
