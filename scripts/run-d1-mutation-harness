}else if(mode==="report_incident_disabled"){
  const file=path.join(root,"packages/git-adapter/src/report-boundary.mjs");let text=fs.readFileSync(file,"utf8");const anchor="      await incidentSink(incident);";if(text.split(anchor).length-1!==1)throw new Error("report incident anchor not exact");text=text.replace(anchor,"      void incident; /* D3_CANARY_REPORT_INCIDENT_DISABLED */");fs.writeFileSync(file,text);
}else throw new Error("unknown canary variant");
NODE
}
make_w1_8_variant(){
  node - "$root_dir/packages/git-adapter/src/credential-boundary.mjs" "$1" "$2" <<'NODE'
const fs=require("node:fs");const [source,target,mode]=process.argv.slice(2);let text=fs.readFileSync(source,"utf8");
function replace(anchor,replacement){if(!text.includes(anchor))throw new Error(`anchor absent: ${anchor}`);text=text.replace(anchor,replacement);}
if(mode==="existence"){
  replace('  const g = await deps.store.getGrant(grantDoc.grant_id); if (!g) return fail("GRANT_NOT_FOUND");','  let g = await deps.store.getGrant(grantDoc.grant_id); if (!g) g=grantDoc; /* W1_8_EXISTENCE_REMOVED */');
  replace('  const fresh = await deps.store.getGrant(g.grant_id);','  const fresh = (await deps.store.getGrant(g.grant_id)) ?? g; /* W1_8_EXISTENCE_REREAD_REMOVED */');
}else if(mode==="tenant")replace('  if (request.tenant_id !== g.tenant_id) return fail("TENANT_MISMATCH");','  if (false /* W1_8_TENANT_REMOVED */) return fail("TENANT_MISMATCH");');
else if(mode==="project")replace('  if (request.project_id !== g.project_id) return fail("PROJECT_MISMATCH");','  if (false /* W1_8_PROJECT_REMOVED */) return fail("PROJECT_MISMATCH");');
else if(mode==="principal")replace('  if (request.principal_id !== g.granted_to_principal_id) return fail("PRINCIPAL_MISMATCH");','  if (false /* W1_8_PRINCIPAL_REMOVED */) return fail("PRINCIPAL_MISMATCH");');
else if(mode==="actor")replace('  if ((g.granted_to_actor_id ?? null) !== (request.actor_id ?? null)) return fail("ACTOR_MISMATCH");','  if (false /* W1_8_ACTOR_REMOVED */) return fail("ACTOR_MISMATCH");');
else if(mode==="scope")replace('  if (!has(new Set(g.scopes), request.scopes ?? [])) return fail("SCOPE_EXCEEDED");','  if (false /* W1_8_SCOPE_REMOVED */) return fail("SCOPE_EXCEEDED");');
else if(mode==="expiry")replace('  if (Date.parse(g.expires_at) <= await deps.store.serverNow()) return fail("GRANT_EXPIRED");','  if (false /* W1_8_EXPIRY_REMOVED */) return fail("GRANT_EXPIRED");');
else if(mode==="revocation")replace('if (!fresh || fresh.status !== "active") return fail("GRANT_REVOKED");','if (false /* W1_8_REVOCATION_REMOVED */) return fail("GRANT_REVOKED");');
else if(mode==="clock")replace('      const result = await client.query("SELECT clock_timestamp() AS server_now");','      const result = await client.query("SELECT \'2000-01-01T00:00:00Z\'::timestamptz AS server_now /* W1_8_CLOCK_CONSTANT */");');
else if(mode==="g1"){
  replace('  const g = await deps.store.getGrant(grantDoc.grant_id); if (!g) return fail("GRANT_NOT_FOUND");','  let g = await deps.store.getGrant(grantDoc.grant_id); if (!g) g=grantDoc; /* W1_8_G1_REMOVED */');
  replace('  const fresh = await deps.store.getGrant(g.grant_id);','  const fresh = (await deps.store.getGrant(g.grant_id)) ?? g;');
}else if(mode==="g2")replace('  if (Date.parse(g.expires_at) <= await deps.store.serverNow()) return fail("GRANT_EXPIRED");','  if (false /* W1_8_G2_REMOVED */) return fail("GRANT_EXPIRED");');
else if(mode==="g3_g12")replace('if (!fresh || fresh.status !== "active") return fail("GRANT_REVOKED");','if (false /* W1_8_G3_G12_REMOVED */) return fail("GRANT_REVOKED");');
else if(mode==="g4")replace('  if (request.tenant_id !== g.tenant_id) return fail("TENANT_MISMATCH");','  if (false /* W1_8_G4_REMOVED */) return fail("TENANT_MISMATCH");');
else if(mode==="g5")replace('  if (request.project_id !== g.project_id) return fail("PROJECT_MISMATCH");','  if (false /* W1_8_G5_REMOVED */) return fail("PROJECT_MISMATCH");');
else if(mode==="g6")replace('  if (request.provider !== g.provider) return fail("PROVIDER_MISMATCH");','  if (false /* W1_8_G6_REMOVED */) return fail("PROVIDER_MISMATCH");');
else if(mode==="g7")replace('  if (request.capability !== g.capability) return fail("CAPABILITY_MISMATCH");','  if (false /* W1_8_G7_REMOVED */) return fail("CAPABILITY_MISMATCH");');
else if(mode==="g8")replace('  if (request.principal_id !== g.granted_to_principal_id) return fail("PRINCIPAL_MISMATCH");','  if (false /* W1_8_G8_REMOVED */) return fail("PRINCIPAL_MISMATCH");');
else if(mode==="g9")replace('  if ((g.granted_to_actor_id ?? null) !== (request.actor_id ?? null)) return fail("ACTOR_MISMATCH");','  if (false /* W1_8_G9_REMOVED */) return fail("ACTOR_MISMATCH");');
else if(mode==="g10")replace('  if (!has(new Set(g.scopes), request.scopes ?? [])) return fail("SCOPE_EXCEEDED");','  if (false /* W1_8_G10_REMOVED */) return fail("SCOPE_EXCEEDED");');
else if(mode==="g13")replace('  if (request.session_id && !(await deps.store.sessionLive(request.session_id))) return fail("SESSION_REVOKED");','  if (false /* W1_8_G13_REMOVED */) return fail("SESSION_REVOKED");');
else if(mode==="g14")replace('if (!row || row.revoked) return fail("CUSTODY_REVOKED");','if (false /* W1_8_G14_REMOVED */) return fail("CUSTODY_REVOKED");');
else throw new Error(`unknown W1-8 variant ${mode}`);
fs.writeFileSync(target,text);
NODE
}
capture_d2(){ local module="$1" pattern="$2" log="$3"; run_d2 "$module" "$pattern" >"$log" 2>&1; return $?; }
capture_w1_7(){ local module="$1" pattern="$2" log="$3"; run_w1_7 "$module" "$pattern" >"$log" 2>&1; return $?; }
mapfile -t MUTATIONS < <(cat "$root_dir/tests/failure/d1-mutations.txt" "$root_dir/tests/failure/d2-mutations.txt" "$root_dir/tests/failure/d3-mutations.txt" "$root_dir/tests/failure/w1-8-mutations.txt" "$root_dir/tests/failure/w1-1-mutations.txt" "$root_dir/tests/failure/w1-1-lifecycle-mutations.txt" "$root_dir/tests/failure/w1-1-manager-mutations.txt" "$root_dir/tests/failure/w1-1-oidc-mutations.txt" "$root_dir/tests/failure/w1-1-oidc-client-mutations.txt" "$root_dir/tests/failure/w1-1-oidc-durable-mutations.txt" "$root_dir/tests/failure/w1-1-oidc-provider-mutations.txt" "$root_dir/tests/failure/w1-1-binding-mutations.txt")
if [ "${1:-}" = "--negative" ]; then MUTATIONS=("NOOP|SELECT 1;|SELECT false"); fi
executed=0
for line in "${MUTATIONS[@]}"; do
  IFS='|' read -r name mutation check <<< "$line"
  if [[ "$mutation" = PORT_WATCH_* ]]; then
    case "$mutation" in
