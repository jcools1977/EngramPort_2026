  replace(managerFile,'    if(approval.session_id!==session_id)throw new SetupPlanError("APPROVAL_SESSION_MISMATCH",approval.approval_id);','    if(false /* W1_1_MANAGER_SESSION_MISMATCH_REMOVED */)throw new SetupPlanError("APPROVAL_SESSION_MISMATCH",approval.approval_id);');
}
if(["different","different_store_only"].includes(mode)){
  replaceLast(storeFile,'  async getApproval(session_id,approval_id){return this.#approvals.get(session_id)?.get(approval_id)??null;}','  async getApproval(session_id,approval_id){const scoped=this.#approvals.get(session_id)?.get(approval_id);if(scoped)return scoped;for(const approvals of this.#approvals.values()){const found=approvals.get(approval_id);if(found)return found;}return null; /* W1_1_MANAGER_APPROVAL_SCOPE_REMOVED */}');
}
if(["replay","replay_guard_only"].includes(mode)){
  replace(managerFile,'    if(await this.#call(()=>this.#store.approvalRevoked(approval.approval_id)))throw new SetupPlanError("APPROVAL_REPLAY_REFUSED",approval.approval_id);','    if(false /* W1_1_MANAGER_REPLAY_GUARD_REMOVED */)throw new SetupPlanError("APPROVAL_REPLAY_REFUSED",approval.approval_id);');
}
if(["replay","replay_retention_only"].includes(mode)){
  replace(storeFile,'  #revokeApprovals(session_id){for(const id of this.#approvals.get(session_id)?.keys()??[])this.#revokedApprovals.add(id);this.#approvals.delete(session_id);}','  #revokeApprovals(session_id){for(const id of this.#approvals.get(session_id)?.keys()??[])this.#revokedApprovals.add(id);void session_id; /* W1_1_MANAGER_APPROVAL_RETENTION_REMOVED */}');
}
if(mode==="revoked-execute"){
  replace(managerFile,'    this.#requireLive(session_id,snapshot);','    void snapshot; /* W1_1_MANAGER_EXECUTE_LIVENESS_REMOVED */');
