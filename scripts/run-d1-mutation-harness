run_repository_surface_policy(){
  local rules="$1" actor_root="${2:-$root_dir/actors}" index="${3:-}" verifier="${4:-$root_dir/packages/git-adapter/src/verify-log.mjs}"
  if [ -n "$index" ]; then
    REPOSITORY_RULES_FILE="$rules" REPOSITORY_ACTOR_ROOT="$actor_root" GIT_INDEX_FILE="$index" GIT_ADAPTER_VERIFY_MODULE="$(agent_c_url "$verifier")" node --test --test-reporter=tap "$root_dir/tests/repository-surface-policy.test.mjs"
  else
    REPOSITORY_RULES_FILE="$rules" REPOSITORY_ACTOR_ROOT="$actor_root" GIT_ADAPTER_VERIFY_MODULE="$(agent_c_url "$verifier")" node --test --test-reporter=tap "$root_dir/tests/repository-surface-policy.test.mjs"
  fi
}
assert_repository_surface_policy(){ local rules="$1" actor_root="${2:-$root_dir/actors}" index="${3:-}" verifier="${4:-$root_dir/packages/git-adapter/src/verify-log.mjs}" out rc; out=$(mktemp); run_repository_surface_policy "$rules" "$actor_root" "$index" "$verifier" >"$out" 2>&1; rc=$?; [ "$rc" = 0 ] || cat "$out" >&2; rm -f "$out"; echo "$rc"; return 0; }
