      PORT_WATCH_OBSERVATION_PRIOR) mode=observation-prior; marker=OBSERVATION_PRIOR_BODY_DIGEST_REMOVED; test_pattern='checkpoint chain binds the prior checkpoint body digest'; suite=watch ;;
      PORT_WATCH_OBSERVATION_DELIVERY) mode=observation-delivery; marker=OBSERVATION_STABLE_DELIVERY_DEDUP_REMOVED; test_pattern='PostgreSQL observation disposition is durable, deduplicated, and subject isolated'; suite=observation_live ;;
      PORT_WATCH_OBSERVATION_RLS) mode=observation-rls; marker=OBSERVATION_FORCED_RLS_SUBJECT_REMOVED; test_pattern='PostgreSQL observation disposition is durable, deduplicated, and subject isolated'; suite=observation_rls ;;
    esac
    source_root="$root_dir"
    if [ "$suite" = observation_rls ]; then
      build || { fail=1; continue; }
      base=$(assert_observation_live "$source_root")
      psql_as postgres "$SDB" -c "CREATE OR REPLACE FUNCTION observation_subject_matches(p_tenant_id uuid,p_subscriber_id uuid) RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path=public AS \$\$ SELECT true /* OBSERVATION_FORCED_RLS_SUBJECT_REMOVED */ \$\$; CREATE OR REPLACE FUNCTION get_observation_checkpoint(p_checkpoint_id uuid) RETURNS SETOF observation_checkpoints LANGUAGE sql SECURITY DEFINER SET search_path=public AS \$\$ SELECT * FROM observation_checkpoints WHERE checkpoint_id=p_checkpoint_id \$\$; ALTER FUNCTION get_observation_checkpoint(uuid) OWNER TO postgres;" >/dev/null 2>&1
      applied=$(psql_as postgres "$SDB" -Atc "SELECT position('OBSERVATION_FORCED_RLS_SUBJECT_REMOVED' in prosrc)>0 FROM pg_proc WHERE oid='observation_subject_matches(uuid,uuid)'::regprocedure" | tr -d '[:space:]')
      log="$mutation_dir/port-watch-observation-rls.log"; run_observation_live "$source_root" >"$log" 2>&1; after=$?
      forbidden=f; grep -Eq "not ok [0-9]+ - $test_pattern|✖ $test_pattern" "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
