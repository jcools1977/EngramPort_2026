  replace(managerFile,'    if(snapshot.state?.status==="expired")throw new SetupPlanError("SESSION_EXPIRED",session_id);','    if(false /* W1_1_MANAGER_EXPIRED_REMOVED */)throw new SetupPlanError("SESSION_EXPIRED",session_id);');
