make_event_extension_case_variant(){
  node - "$root_dir/packages/git-adapter/src/verify-log.mjs" "$1" "$root_dir/packages/git-adapter/src/cli.mjs" "$2" "$root_dir/packages/git-adapter/src/event-core.mjs" "$3" "$root_dir" <<'NODE'
