m3_probe(){
  local expected="$1" out rc landed
  psql_as postgres "$SDB" -c "INSERT INTO projects(id,tenant_id,slug,name) VALUES ('02000000-0000-0000-0000-0000000000ff','10000000-0000-0000-0000-000000000001','d3-m3-probe','D3 M3 Probe'); INSERT INTO project_memberships(tenant_id,project_id,principal_id,role) VALUES ('10000000-0000-0000-0000-000000000001','02000000-0000-0000-0000-0000000000ff','11000000-0000-0000-0000-000000000001','reader');" >/dev/null || { echo 1; return 0; }
  out=$(mktemp)
  psql_as engram_maintenance "$SDB" -c "SELECT set_config('app.principal_id','11000000-0000-0000-0000-000000000001',false); SELECT set_config('app.session_id','15000000-0000-0000-0000-000000000008',false); SELECT mint_custody_reference('3.3','credential','B','d3-m3-layer-probe','{}');" >"$out" 2>&1; rc=$?
  landed=$(psql_as postgres "$SDB" -Atc "SELECT count(*) FROM custody_rows WHERE key_locator='d3-m3-layer-probe'" | tr -d '[:space:]')
  psql_as postgres "$SDB" -c "TRUNCATE custody_audit,minted_references,custody_rows; DELETE FROM project_memberships WHERE project_id='02000000-0000-0000-0000-0000000000ff'; DELETE FROM projects WHERE id='02000000-0000-0000-0000-0000000000ff';" >/dev/null
  if [ "$rc" != 0 ] && [ "$landed" = 0 ] && grep -Fq "$expected" "$out"; then echo 0; else cat "$out" >&2; echo 1; fi
  rm -f "$out"
  return 0
}
