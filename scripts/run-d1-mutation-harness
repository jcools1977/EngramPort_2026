      W1_1_MANAGER_CRITERION3_REVOKED_EXECUTE) pattern=revoked-execute; expected="W1_1_CRITERION3 revoked_execute positive=authorized negative=accepted genuine=true unreplayed=true durable=completed" ;;
      W1_1_MANAGER_CRITERION5_DIFFERENT) pattern=different; expected="W1_1_CRITERION5 different positive=authorized negative=accepted" ;;
      W1_1_MANAGER_CRITERION5_REPLAY) pattern=replay; expected="W1_1_CRITERION5 replay positive=authorized negative=accepted" ;;
    esac
    build || { fail=1; continue; }
    base=$(assert_w1_1_manager "$root_dir" "$pattern")
    if [ "$pattern" = expired ]; then
      guard_variant="$mutation_dir/w1-1-manager-expired-guard"; live_variant="$mutation_dir/w1-1-manager-expired-live"
      make_w1_1_manager_variant "$guard_variant" expired_guard_only || { fail=1; continue; }; guard_only=$(assert_w1_1_manager "$guard_variant" "$pattern")
      make_w1_1_manager_variant "$live_variant" liveness_only || { fail=1; continue; }; live_only=$(assert_w1_1_manager "$live_variant" "$pattern")
    elif [ "$pattern" = different ]; then
      guard_variant="$mutation_dir/w1-1-manager-different-guard"; store_variant="$mutation_dir/w1-1-manager-different-store"
      make_w1_1_manager_variant "$guard_variant" different_manager_only || { fail=1; continue; }; guard_only=$(assert_w1_1_manager "$guard_variant" "$pattern")
      make_w1_1_manager_variant "$store_variant" different_store_only || { fail=1; continue; }; store_only=$(assert_w1_1_manager "$store_variant" "$pattern")
    elif [ "$pattern" = replay ]; then
      guard_variant="$mutation_dir/w1-1-manager-replay-guard"; live_variant="$mutation_dir/w1-1-manager-replay-live"; retention_variant="$mutation_dir/w1-1-manager-replay-retention"
      make_w1_1_manager_variant "$guard_variant" replay_guard_only || { fail=1; continue; }; guard_only=$(assert_w1_1_manager "$guard_variant" "$pattern")
      make_w1_1_manager_variant "$live_variant" liveness_only || { fail=1; continue; }; live_only=$(assert_w1_1_manager "$live_variant" "$pattern")
      make_w1_1_manager_variant "$retention_variant" replay_retention_only || { fail=1; continue; }; retention_only=$(assert_w1_1_manager "$retention_variant" "$pattern")
    fi
    variant="$mutation_dir/w1-1-manager-$pattern-combined"; make_w1_1_manager_variant "$variant" "$pattern" || { fail=1; continue; }
    case "$pattern" in
      expired) grep -Rq 'W1_1_MANAGER_EXPIRED_REMOVED' "$variant" && grep -Rq 'W1_1_MANAGER_LIVENESS_REMOVED' "$variant" && applied=t || applied=f ;;
      revoked) grep -Rq 'W1_1_MANAGER_LIVENESS_REMOVED' "$variant" && applied=t || applied=f ;;
      revoked-execute) grep -Rq 'W1_1_MANAGER_EXECUTE_LIVENESS_REMOVED' "$variant" && applied=t || applied=f ;;
      different) grep -Rq 'W1_1_MANAGER_SESSION_MISMATCH_REMOVED' "$variant" && grep -Rq 'W1_1_MANAGER_APPROVAL_SCOPE_REMOVED' "$variant" && applied=t || applied=f ;;
      replay) grep -Rq 'W1_1_MANAGER_REPLAY_GUARD_REMOVED' "$variant" && grep -Rq 'W1_1_MANAGER_LIVENESS_REMOVED' "$variant" && grep -Rq 'W1_1_MANAGER_APPROVAL_RETENTION_REMOVED' "$variant" && applied=t || applied=f ;;
    esac
    log="$mutation_dir/w1-1-manager-$pattern.log"; run_w1_1_manager "$variant" "$pattern" >"$log" 2>&1; after=$?
    forbidden=f; grep -Fq "$expected" "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
    build >/dev/null 2>&1; restored=$(assert_w1_1_manager "$root_dir" "$pattern")
    if [ "$pattern" = expired ]; then
      printf 'W1_1_MANAGER_EXPIRED baseline=%s guard_only=%s liveness_only=%s applied=%s combined=%s forbidden=%s restored=%s\n' "$base" "$guard_only" "$live_only" "$applied" "$after" "$forbidden" "$restored"
      [ "$guard_only" = 0 ] && [ "$live_only" = 0 ] || fail=1
    elif [ "$pattern" = different ]; then
      printf 'W1_1_MANAGER_DIFFERENT baseline=%s manager_only=%s store_only=%s applied=%s combined=%s forbidden=%s restored=%s\n' "$base" "$guard_only" "$store_only" "$applied" "$after" "$forbidden" "$restored"
      [ "$guard_only" != 0 ] && [ "$store_only" = 0 ] || fail=1
    elif [ "$pattern" = replay ]; then
      printf 'W1_1_MANAGER_REPLAY baseline=%s guard_only=%s liveness_only=%s retention_only=%s applied=%s combined=%s forbidden=%s restored=%s\n' "$base" "$guard_only" "$live_only" "$retention_only" "$applied" "$after" "$forbidden" "$restored"
      [ "$guard_only" != 0 ] && [ "$live_only" = 0 ] && [ "$retention_only" = 0 ] || fail=1
    elif [ "$pattern" = revoked-execute ]; then
      printf 'W1_1_MANAGER_REVOKED_EXECUTE baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$base" "$applied" "$after" "$forbidden" "$restored"
    else
      printf 'W1_1_MANAGER_REVOKED baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$base" "$applied" "$after" "$forbidden" "$restored"
    fi
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = W1_1_REPEAT_SAFETY ]; then
    build || { fail=1; continue; }
    base=$(assert_w1_1_lifecycle repeat-safety)
    marker=W1_1_REPEAT_REPORT_REMOVED; anchor="RETURN swept;"; replacement="RETURN 1; /* $marker */"
    psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'$anchor','$replacement') WHERE oid='sweep_expired_setup_session_delegations()'::regprocedure;" >/dev/null || { fail=1; continue; }
    applied=$(psql_as postgres "$SDB" -Atc "SELECT position('$marker' in prosrc)>0 AND position('$anchor' in prosrc)=0 FROM pg_proc WHERE oid='sweep_expired_setup_session_delegations()'::regprocedure" | tr -d '[:space:]')
    log="$mutation_dir/w1-1-repeat-safety.log"; run_w1_1_lifecycle repeat-safety >"$log" 2>&1; after=$?
    forbidden=f; grep -Fq "W1_1_LIFECYCLE repeat first=1 second=1 third=1 terminal_stable=true live=active" "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
    build >/dev/null 2>&1; restored=$(assert_w1_1_lifecycle repeat-safety)
    printf 'W1_1_SETUP_SESSION_REPEAT_SAFETY baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = W1_1_LIFECYCLE_PROPERTIES ]; then
    for property in read-expiry sweep introspection clock read-terminal already-terminal ownership atomic; do
      build || { fail=1; continue; }
      base=$(assert_w1_1_lifecycle "$property")
      if [ "$property" = ownership ]; then
        select_anchor="AND s.founder_principal_id=principal"; update_anchor="AND founder_principal_id=principal"; marker=W1_1_OWNERSHIP_PREDICATES_REMOVED
        psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(replace(prosrc,'$select_anchor','AND true /* $marker */'),'$update_anchor','AND true') WHERE oid='transition_setup_session_delegation(uuid,text)'::regprocedure;" >/dev/null || { fail=1; continue; }
        predicate_only=$(assert_w1_1_lifecycle "$property")
        build >/dev/null 2>&1 || { fail=1; continue; }
        psql_as postgres "$SDB" -c "DROP POLICY setup_session_founder ON setup_session_delegations; CREATE POLICY setup_session_founder ON setup_session_delegations USING(true) WITH CHECK(true);" >/dev/null || { fail=1; continue; }
        rls_only=$(assert_w1_1_lifecycle "$property")
        psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(replace(prosrc,'$select_anchor','AND true /* $marker */'),'$update_anchor','AND true') WHERE oid='transition_setup_session_delegation(uuid,text)'::regprocedure;" >/dev/null || { fail=1; continue; }
        applied=$(psql_as postgres "$SDB" -Atc "SELECT position('$marker' in (SELECT prosrc FROM pg_proc WHERE oid='transition_setup_session_delegation(uuid,text)'::regprocedure))>0 AND position('$select_anchor' in (SELECT prosrc FROM pg_proc WHERE oid='transition_setup_session_delegation(uuid,text)'::regprocedure))=0 AND position('$update_anchor' in (SELECT prosrc FROM pg_proc WHERE oid='transition_setup_session_delegation(uuid,text)'::regprocedure))=0 AND (SELECT pg_get_expr(polqual,polrelid)='true' FROM pg_policy WHERE polname='setup_session_founder')" | tr -d '[:space:]')
        log="$mutation_dir/w1-1-lifecycle-ownership.log"; run_w1_1_lifecycle "$property" >"$log" 2>&1; after=$?
        forbidden=f; grep -Fq 'W1_1_LIFECYCLE ownership result=accepted state=completed' "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
        build >/dev/null 2>&1; restored=$(assert_w1_1_lifecycle "$property")
        printf 'W1_1_LIFECYCLE_OWNERSHIP baseline=%s predicate_only=%s rls_only=%s applied=%s combined=%s forbidden=%s restored=%s\n' "$base" "$predicate_only" "$rls_only" "$applied" "$after" "$forbidden" "$restored"
        executed=$((executed+1)); [ "$base" = 0 ] && [ "$predicate_only" = 0 ] && [ "$rls_only" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
        continue
      fi
      if [ "$property" = atomic ]; then
        anchor="SET terminal_state=p_terminal_state,terminal_at=transition_clock"; marker=W1_1_TERMINAL_TIMESTAMP_REMOVED
        psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'$anchor','SET terminal_state=p_terminal_state /* $marker */') WHERE oid='transition_setup_session_delegation(uuid,text)'::regprocedure;" >/dev/null || { fail=1; continue; }
        assignment_only=$(assert_w1_1_lifecycle "$property")
        build >/dev/null 2>&1 || { fail=1; continue; }
        psql_as postgres "$SDB" -c "ALTER TABLE setup_session_delegations DROP CONSTRAINT setup_session_delegations_check;" >/dev/null || { fail=1; continue; }
        constraint_only=$(assert_w1_1_lifecycle "$property")
        psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'$anchor','SET terminal_state=p_terminal_state /* $marker */') WHERE oid='transition_setup_session_delegation(uuid,text)'::regprocedure;" >/dev/null || { fail=1; continue; }
        applied=$(psql_as postgres "$SDB" -Atc "SELECT position('$marker' in prosrc)>0 AND NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='setup_session_delegations'::regclass AND conname='setup_session_delegations_check') FROM pg_proc WHERE oid='transition_setup_session_delegation(uuid,text)'::regprocedure" | tr -d '[:space:]')
        log="$mutation_dir/w1-1-lifecycle-atomic.log"; run_w1_1_lifecycle "$property" >"$log" 2>&1; after=$?
        forbidden=f; grep -Fq 'W1_1_LIFECYCLE atomic=false result=accepted state=completed stamped=false' "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
        build >/dev/null 2>&1; restored=$(assert_w1_1_lifecycle "$property")
        printf 'W1_1_LIFECYCLE_ATOMIC baseline=%s assignment_only=%s constraint_only=%s applied=%s combined=%s forbidden=%s restored=%s\n' "$base" "$assignment_only" "$constraint_only" "$applied" "$after" "$forbidden" "$restored"
        executed=$((executed+1)); [ "$base" = 0 ] && [ "$assignment_only" != 0 ] && [ "$constraint_only" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
        continue
      fi
      case "$property" in
        read-expiry) oid="read_live_setup_session_delegation(uuid)"; anchor="AND s.expires_at>clock_timestamp()"; replacement="AND true /* W1_1_READ_EXPIRY_REMOVED */"; marker=W1_1_READ_EXPIRY_REMOVED; expected="W1_1_LIFECYCLE read_expiry live=1 expired=1" ;;
        sweep) oid="sweep_expired_setup_session_delegations()"; anchor="AND expires_at<=sweep_clock"; replacement="AND false /* W1_1_SWEEP_REMOVED */"; marker=W1_1_SWEEP_REMOVED; expected="W1_1_LIFECYCLE sweep swept=0 expired_state=none expired_stamped=false live_state=none" ;;
        introspection) oid="inspect_setup_session_delegation(uuid)"; anchor="AND s.expires_at>snapshot_clock"; replacement="AND true /* W1_1_INSPECTION_EXPIRY_REMOVED */"; marker=W1_1_INSPECTION_EXPIRY_REMOVED; expected="expired_active=true expired_state=expired" ;;
        clock) oid="inspect_setup_session_delegation(uuid)"; anchor="snapshot_clock timestamptz:=clock_timestamp();"; replacement="snapshot_clock timestamptz:=to_timestamp(946684800); /* W1_1_DB_CLOCK_REMOVED */"; marker=W1_1_DB_CLOCK_REMOVED; expected="W1_1_LIFECYCLE clock_db=false" ;;
        already-terminal) oid="transition_setup_session_delegation(uuid,text)"; anchor="IF row_terminal_state IS NOT NULL THEN"; replacement="IF false /* W1_1_ALREADY_TERMINAL_REMOVED */ THEN"; marker=W1_1_ALREADY_TERMINAL_REMOVED; expected="W1_1_LIFECYCLE already_terminal second=accepted state=abandoned" ;;
      esac
      if [ "$property" = read-terminal ]; then
        oid="read_live_setup_session_delegation(uuid)"; marker=W1_1_READ_TERMINAL_REMOVED; expected="W1_1_LIFECYCLE read_terminal live=1 terminal=1"
        psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(replace(prosrc,'AND s.terminal_state IS NULL','AND true /* $marker */'),'AND s.terminal_at IS NULL','AND true') WHERE oid='$oid'::regprocedure;" >/dev/null || { fail=1; continue; }
        applied=$(psql_as postgres "$SDB" -Atc "SELECT position('$marker' in prosrc)>0 AND position('s.terminal_state IS NULL' in prosrc)=0 AND position('s.terminal_at IS NULL' in prosrc)=0 FROM pg_proc WHERE oid='$oid'::regprocedure" | tr -d '[:space:]')
      else
        psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'$anchor','$replacement') WHERE oid='$oid'::regprocedure;" >/dev/null || { fail=1; continue; }
        applied=$(psql_as postgres "$SDB" -Atc "SELECT position('$marker' in prosrc)>0 AND position('$anchor' in prosrc)=0 FROM pg_proc WHERE oid='$oid'::regprocedure" | tr -d '[:space:]')
      fi
      log="$mutation_dir/w1-1-lifecycle-$property.log"; run_w1_1_lifecycle "$property" >"$log" 2>&1; after=$?
      forbidden=f; grep -Fq "$expected" "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
      build >/dev/null 2>&1; restored=$(assert_w1_1_lifecycle "$property")
      printf 'W1_1_LIFECYCLE_%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$(printf '%s' "$property" | tr '[:lower:]-' '[:upper:]_')" "$base" "$applied" "$after" "$forbidden" "$restored"
      executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    done
    continue
  fi
  if [ "$mutation" = W1_1_SETUP_SESSION_PROPERTIES ]; then
    for property in nonsetup scope authority-expiry retention; do
      build || { fail=1; continue; }
      base=$(assert_w1_1 "$property")
      case "$property" in
        nonsetup) marker=W1_1_NONSETUP_REMOVED; anchor="IF NOT setup_scopes_only(p_scopes) THEN"; expected="W1_1_CREATE nonsetup=accepted landed=1" ;;
        scope) marker=W1_1_SCOPE_REMOVED; anchor="IF NOT (p_scopes <@ authority_scopes) THEN"; expected="W1_1_CREATE scope=accepted landed=1" ;;
        authority-expiry) marker=W1_1_AUTHORITY_EXPIRY_REMOVED; anchor="IF p_expires_at > authority_expires_at THEN"; expected="W1_1_CREATE authority_expiry=accepted landed=1" ;;
        retention) marker=W1_1_RETENTION_REMOVED; anchor="IF p_expires_at > created_at_value+retention_window THEN"; expected="W1_1_CREATE retention=accepted landed=1" ;;
      esac
      if [ "$property" = nonsetup ]; then
        psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'$anchor','IF false /* $marker */ THEN') WHERE oid='create_setup_session_delegation(uuid,text[],timestamptz,uuid)'::regprocedure;" >/dev/null || { fail=1; continue; }
        boundary_log="$mutation_dir/w1-1-nonsetup-boundary-only.log"; run_w1_1 "$property" >"$boundary_log" 2>&1; boundary_only=$?
        build >/dev/null 2>&1
        psql_as postgres "$SDB" -c "ALTER TABLE setup_session_delegations DROP CONSTRAINT setup_session_delegations_scopes_check;" >/dev/null || { fail=1; continue; }
        table_only=$(assert_w1_1 "$property")
        psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'$anchor','IF false /* $marker */ THEN') WHERE oid='create_setup_session_delegation(uuid,text[],timestamptz,uuid)'::regprocedure;" >/dev/null || { fail=1; continue; }
        applied=$(psql_as postgres "$SDB" -Atc "SELECT position('$marker' in prosrc)>0 AND position('$anchor' in prosrc)=0 AND NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conrelid='setup_session_delegations'::regclass AND conname='setup_session_delegations_scopes_check') FROM pg_proc WHERE oid='create_setup_session_delegation(uuid,text[],timestamptz,uuid)'::regprocedure" | tr -d '[:space:]')
        log="$mutation_dir/w1-1-nonsetup-combined.log"; run_w1_1 "$property" >"$log" 2>&1; after=$?
        forbidden=f; grep -Fq "$expected" "$log" && forbidden=t; [ "$forbidden" = t ] || { cat "$boundary_log" >&2; cat "$log" >&2; }
        build >/dev/null 2>&1; restored=$(assert_w1_1 "$property")
        printf 'W1_1_SETUP_NONSETUP baseline=%s boundary_only=%s table_only=%s applied=%s combined=%s forbidden=%s restored=%s\n' "$base" "$boundary_only" "$table_only" "$applied" "$after" "$forbidden" "$restored"
        executed=$((executed+1)); [ "$base" = 0 ] && [ "$boundary_only" != 0 ] && [ "$table_only" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
        continue
      fi
      psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'$anchor','IF false /* $marker */ THEN') WHERE oid='create_setup_session_delegation(uuid,text[],timestamptz,uuid)'::regprocedure;" >/dev/null || { fail=1; continue; }
      applied=$(psql_as postgres "$SDB" -Atc "SELECT position('$marker' in prosrc)>0 AND position('$anchor' in prosrc)=0 FROM pg_proc WHERE oid='create_setup_session_delegation(uuid,text[],timestamptz,uuid)'::regprocedure" | tr -d '[:space:]')
      log="$mutation_dir/w1-1-$property.log"; run_w1_1 "$property" >"$log" 2>&1; after=$?
      forbidden=f; grep -Fq "$expected" "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
      build >/dev/null 2>&1; restored=$(assert_w1_1 "$property")
      printf 'W1_1_SETUP_%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$(printf '%s' "$property" | tr '[:lower:]-' '[:upper:]_')" "$base" "$applied" "$after" "$forbidden" "$restored"
      executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    done
    continue
  fi
  if [ "$mutation" = W1_8_SOURCE_PROPERTIES ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/credential-boundary.mjs"
    for property in existence tenant project principal actor scope expiry revocation clock; do
      base=$(assert_w1_8 "$source_module" "$property")
      variant="$mutation_dir/w1-8-$property.mjs"; make_w1_8_variant "$variant" "$property" || { fail=1; continue; }
      if grep -Fq "W1_8_$(printf '%s' "$property" | tr '[:lower:]' '[:upper:]')" "$variant"; then applied=t; else applied=f; fi
      log="$mutation_dir/w1-8-$property.log"; run_w1_8 "$variant" "$property" >"$log" 2>&1; after=$?
      forbidden=f
      if [ "$property" = clock ]; then grep -Fq 'W1_8_LIVE_PROPERTY clock_db=false' "$log" && forbidden=t; else grep -Fq "W1_8_LIVE_PROPERTY $property=accepted" "$log" && forbidden=t; fi
      [ "$forbidden" = t ] || cat "$log" >&2
      restored=$(assert_w1_8 "$source_module" "$property")
      printf 'W1_8_LIVE_%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$(printf '%s' "$property" | tr '[:lower:]' '[:upper:]')" "$base" "$applied" "$after" "$forbidden" "$restored"
      executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    done
    continue
  fi
  if [ "$mutation" = W1_8_DB_REMOVE_CREATE_SCOPE ] || [ "$mutation" = W1_8_DB_REMOVE_CREATE_EXPIRY ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/credential-boundary.mjs"
    if [ "$mutation" = W1_8_DB_REMOVE_CREATE_SCOPE ]; then
      pattern="creation-scope"; marker="W1_8_CREATE_SCOPE_REMOVED"; anchor="IF NOT (p_scopes <@ authority_scopes) THEN"; expected="W1_8_CREATE scope=accepted landed=1"
    else
      pattern="creation-expiry"; marker="W1_8_CREATE_EXPIRY_REMOVED"; anchor="IF p_expires_at > authority_expires_at THEN"; expected="W1_8_CREATE expiry=accepted landed=1"
    fi
    base=$(assert_w1_8 "$source_module" "$pattern")
    psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'$anchor','IF false /* $marker */ THEN') WHERE oid='create_invocation_grant(uuid,text,text,uuid,uuid,uuid,text[],text,text,timestamptz,uuid)'::regprocedure;" >/dev/null || { fail=1; continue; }
    applied=$(psql_as postgres "$SDB" -Atc "SELECT position('$marker' in prosrc)>0 AND position('$anchor' in prosrc)=0 FROM pg_proc WHERE oid='create_invocation_grant(uuid,text,text,uuid,uuid,uuid,text[],text,text,timestamptz,uuid)'::regprocedure" | tr -d '[:space:]')
    log="$mutation_dir/${name}.log"; run_w1_8 "$source_module" "$pattern" >"$log" 2>&1; after=$?
    forbidden=f; grep -Fq "$expected" "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
    build >/dev/null 2>&1; restored=$(assert_w1_8 "$source_module" "$pattern")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = W1_8_G_PROPERTIES ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/credential-boundary.mjs"
    for control in $(seq 1 14); do
      [ "$control" = 12 ] && continue
      pattern="g$control"; base=$(assert_w1_8 "$source_module" "$pattern")
      if [ "$control" = 3 ]; then
        g12_base=$(assert_w1_8 "$source_module" g12)
        variant="$mutation_dir/w1-8-g3-g12.mjs"; make_w1_8_variant "$variant" g3_g12 || { fail=1; continue; }
        if grep -Fq "W1_8_G3_G12_REMOVED" "$variant"; then applied=t; else applied=f; fi
        g3_log="$mutation_dir/w1-8-g3.log"; run_w1_8 "$variant" g3 >"$g3_log" 2>&1; starts_revoked=$?
        g12_log="$mutation_dir/w1-8-g12.log"; run_w1_8 "$variant" g12 >"$g12_log" 2>&1; revoked_between_reads=$?
        forbidden=f
        if grep -Fq "W1_8_G3 positive=accepted negative=accepted" "$g3_log" && grep -Fq "W1_8_G12 positive=accepted negative=accepted" "$g12_log"; then forbidden=t; fi
        [ "$forbidden" = t ] || { cat "$g3_log" >&2; cat "$g12_log" >&2; }
        g12_restored=$(assert_w1_8 "$source_module" g12); restored=$(assert_w1_8 "$source_module" g3)
        printf 'W1_8_G3_G12 baseline=%s/%s starts_revoked=%s revoked_between_reads=%s applied=%s forbidden=%s restored=%s/%s\n' "$base" "$g12_base" "$starts_revoked" "$revoked_between_reads" "$applied" "$forbidden" "$restored" "$g12_restored"
        executed=$((executed+1)); [ "$base" = 0 ] && [ "$g12_base" = 0 ] && [ "$starts_revoked" != 0 ] && [ "$revoked_between_reads" != 0 ] && [ "$applied" = t ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] && [ "$g12_restored" = 0 ] || fail=1
        continue
      elif [ "$control" = 11 ]; then
        marker="W1_8_G11_REMOVED"; anchor="IF NOT (p_scopes <@ authority_scopes) THEN"
        psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'$anchor','IF false /* $marker */ THEN') WHERE oid='create_invocation_grant(uuid,text,text,uuid,uuid,uuid,text[],text,text,timestamptz,uuid)'::regprocedure;" >/dev/null || { fail=1; continue; }
        applied=$(psql_as postgres "$SDB" -Atc "SELECT position('$marker' in prosrc)>0 AND position('$anchor' in prosrc)=0 FROM pg_proc WHERE oid='create_invocation_grant(uuid,text,text,uuid,uuid,uuid,text[],text,text,timestamptz,uuid)'::regprocedure" | tr -d '[:space:]')
        variant="$source_module"
      else
        variant="$mutation_dir/w1-8-g$control.mjs"; make_w1_8_variant "$variant" "$pattern" || { fail=1; continue; }
        if grep -Fq "W1_8_G${control}_REMOVED" "$variant"; then applied=t; else applied=f; fi
      fi
      log="$mutation_dir/w1-8-g$control.log"; run_w1_8 "$variant" "$pattern" >"$log" 2>&1; after=$?
      forbidden=f; grep -Fq "W1_8_G${control} positive=accepted negative=accepted" "$log" && forbidden=t; [ "$forbidden" = t ] || cat "$log" >&2
      if [ "$control" = 11 ]; then build >/dev/null 2>&1; fi
      restored=$(assert_w1_8 "$source_module" "$pattern")
      printf 'W1_8_G%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$control" "$base" "$applied" "$after" "$forbidden" "$restored"
      executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    done
    continue
  fi
