#!/usr/bin/env bash
set -uo pipefail
root_dir="$(cd "$(dirname "$0")/.." && pwd)"; compose=(docker compose -f "$root_dir/deploy/docker-compose.yml"); SDB=engramport_mut; fail=0; mutation_dir="$(mktemp -d "$root_dir/.d2-mutations.XXXXXX")"
psql_as(){ "${compose[@]}" exec -T postgres psql -q -v ON_ERROR_STOP=1 -U "$1" -d "$2" "${@:3}"; }
drop(){ "${compose[@]}" exec -T postgres psql -q -U postgres -d postgres -c "DROP DATABASE IF EXISTS $SDB WITH (FORCE);" >/dev/null 2>&1 || true; }
cleanup(){ rc=$?; drop; "${compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true; rm -rf "$mutation_dir"; exit $rc; }
trap cleanup EXIT INT TERM
"${compose[@]}" up -d --wait >/dev/null
build(){ drop; psql_as postgres postgres -c "CREATE DATABASE $SDB OWNER engram_migrator;" >/dev/null || return 1; psql_as postgres "$SDB" < "$root_dir/deploy/init-extensions.sql" >/dev/null || return 1; for m in "$root_dir"/migrations/000[1-9]_*.sql "$root_dir"/migrations/001[0-9]_*.sql; do [ -f "$m" ] || continue; psql_as engram_migrator "$SDB" < "$m" >/dev/null || return 1; done; psql_as postgres "$SDB" < "$root_dir/deploy/seed.sql" >/dev/null || return 1; psql_as postgres "$SDB" -c "INSERT INTO custody_inventory_models(credential_class,custody_model) VALUES ('3.2','B'),('3.12','A') ON CONFLICT DO NOTHING;" >/dev/null || return 1; psql_as engram_migrator "$SDB" -c "INSERT INTO credential_class_gates(credential_class,gate_id,passed,threat_revision,threat_digest) VALUES ('3.3','C3',true,8,'629ae3f2654aba46e4c1158fc234c6b24831a369505ccf41878af3207b091089'),('3.5','C10',true,8,'629ae3f2654aba46e4c1158fc234c6b24831a369505ccf41878af3207b091089'),('3.12','C14',true,8,'629ae3f2654aba46e4c1158fc234c6b24831a369505ccf41878af3207b091089') ON CONFLICT (credential_class) DO UPDATE SET passed=true,threat_revision=EXCLUDED.threat_revision,threat_digest=EXCLUDED.threat_digest;" >/dev/null || return 1; psql_as postgres "$SDB" -c "INSERT INTO founder_authorities(principal_id,scopes,expires_at) VALUES ('11000000-0000-0000-0000-000000000001',ARRAY['custody:mint:credential:3.3:B','custody:mint:credential:3.12:A','custody:mint:shape:3.12:A','custody:mint:installation:3.12:A'],clock_timestamp()+interval '2 hours'),('22000000-0000-0000-0000-000000000002',ARRAY['custody:mint:credential:3.3:B'],clock_timestamp()+interval '2 hours') ON CONFLICT(principal_id) DO UPDATE SET scopes=EXCLUDED.scopes,expires_at=EXCLUDED.expires_at;" >/dev/null; }
assert_file(){ local fixture="$1" out rc; out=$(mktemp); psql_as engram_maintenance "$SDB" -f - < "$fixture" >"$out" 2>&1; rc=$?; [ "$rc" = 0 ] || cat "$out" >&2; rm -f "$out"; echo "$rc"; return 0; }
run_d2(){ local module="$1" pattern="${2:-}"; D2_DATABASE_URL="postgres://engram_maintenance:local-only-maintenance@127.0.0.1:55432/$SDB" D2_APP_DATABASE_URL="postgres://engram_app:local-only-app@127.0.0.1:55432/$SDB" D2_POSTGRES_DATABASE_URL="postgres://postgres:local-only-engramport@127.0.0.1:55432/$SDB" D2_BINDING_MODULE="$module" D2_CASE="$pattern" node --test --test-timeout=10000 "$root_dir/tests/d2-live.test.mjs"; }
assert_d2(){ local module="${1:-$root_dir/packages/git-adapter/src/d2-session-binding.mjs}" pattern="${2:-}" out rc; out=$(mktemp); run_d2 "$module" "$pattern" >"$out" 2>&1; rc=$?; [ "$rc" = 0 ] || cat "$out" >&2; rm -f "$out"; echo "$rc"; return 0; }
run_w1_7(){ local module="$1" pattern="${2:-}"; W1_7_DATABASE_URL="postgres://engram_maintenance:local-only-maintenance@127.0.0.1:55432/$SDB" W1_7_POSTGRES_DATABASE_URL="postgres://postgres:local-only-engramport@127.0.0.1:55432/$SDB" W1_7_BINDING_MODULE="$module" W1_7_CASE="$pattern" node --test --test-timeout=10000 "$root_dir/tests/wizard-w1-7.test.mjs"; }
assert_w1_7(){ local module="${1:-$root_dir/packages/git-adapter/src/d2-session-binding.mjs}" pattern="${2:-}" out rc; out=$(mktemp); run_w1_7 "$module" "$pattern" >"$out" 2>&1; rc=$?; [ "$rc" = 0 ] || cat "$out" >&2; rm -f "$out"; echo "$rc"; return 0; }
run_canary(){ local module_root="$1"; W1_7_CANARY_MODULE_ROOT="$module_root" W1_7_CASE=canary node --test --test-timeout=10000 "$root_dir/tests/wizard-w1-7.test.mjs"; }
assert_canary(){ local module_root="$1" out rc; out=$(mktemp); run_canary "$module_root" >"$out" 2>&1; rc=$?; [ "$rc" = 0 ] || cat "$out" >&2; rm -f "$out"; echo "$rc"; return 0; }
assert(){ local first second third; first=$(assert_file "$root_dir/tests/failure/d1-behavioural.sql"); if [ "$first" != 0 ]; then echo "$first"; return 0; fi; second=$(assert_file "$root_dir/tests/failure/d1f-controls.sql"); if [ "$second" != 0 ]; then echo "$second"; return 0; fi; third=$(assert_d2); echo "$third"; return 0; }
plant_d1f_residue(){ psql_as postgres "$SDB" -c "INSERT INTO custody_rows(id,tenant_id,project_id,namespace,credential_class,custody_model,inventory_model,required_scope,key_locator,metadata,minted_by_principal_id,terminal_at,retention_policy) VALUES ('d1f00000-0000-4000-8000-000000000011','10000000-0000-0000-0000-000000000001','12000000-0000-0000-0000-000000000001','credential','3.3','B','B','custody:mint:credential:3.3:B','d1f-m11','{}','11000000-0000-0000-0000-000000000001',clock_timestamp(),'RET-AUDIT-400');" >/dev/null; }
make_d2_variant(){
  node - "$root_dir/packages/git-adapter/src/d2-session-binding.mjs" "$1" "$2" <<'NODE'
const fs=require("node:fs"); const [source,target,mode]=process.argv.slice(2); let text=fs.readFileSync(source,"utf8");
function replace(anchor,replacement){ if(!text.includes(anchor)) throw new Error(`anchor absent: ${anchor}`); text=text.split(anchor).join(replacement); }
if(mode==="substitution") replace("[session.principalId]","[request.principalId ?? session.principalId]");
if(["local_false","joint","dirty_fault","dirty_weakened"].includes(mode)) replace("SELECT set_config('app.principal_id', $1, true)","SELECT set_config('app.principal_id', $1, false)");
if(["no_scrub","joint"].includes(mode)) replace('      try { await client.query("DISCARD ALL"); } catch (error) { scrubError = error; }',"");
if(mode==="role") replace('      if (role.rows[0]?.session_user !== "engram_maintenance") throw new SessionBindingError("SESSION_ROLE_INVALID");',"");
if(["dirty_fault","dirty_weakened"].includes(mode)) replace('client.query("DISCARD ALL")','client.query("DISCARD ALLXX")');
if(mode==="dirty_weakened") replace("client.release(scrubError)","client.release()");
if(mode==="rollback_mint") replace('      await client.query("COMMIT");','      await client.query("ROLLBACK");');
if(mode==="swallow_refusal") replace("      throw error;",'      return { reference: "epr:credential:01a02095-c806-7000-8000-000000000001", principalId: session.principalId };');
fs.writeFileSync(target,text);
NODE
}
make_canary_variant(){
  local target="$1" mode="$2"
  mkdir -p "$target/packages/git-adapter" "$target/packages/port-watch" "$target/schemas"
  cp -R "$root_dir/packages/git-adapter/src" "$target/packages/git-adapter/" || return 1
  cp -R "$root_dir/packages/port-watch/src" "$target/packages/port-watch/" || return 1
  cp -R "$root_dir/schemas/." "$target/schemas/" || return 1
  node - "$target" "$mode" <<'NODE'
const fs=require("node:fs"),path=require("node:path");const [root,mode]=process.argv.slice(2);
if(mode==="detector_disabled"){
  const file=path.join(root,"packages/git-adapter/src/credential-boundary.mjs");let text=fs.readFileSync(file,"utf8");const anchor="if (SECRET.test(v)) return \"CREDENTIAL_DETECTED\";";if(!text.includes(anchor))throw new Error("detector anchor absent");text=text.replace(anchor,"if (false /* D3_CANARY_DETECTOR_DISABLED */) return \"CREDENTIAL_DETECTED\";");fs.writeFileSync(file,text);
}else if(mode==="observer_neutered"){
  const file=path.join(root,"packages/git-adapter/src/custody-service.mjs");let text=fs.readFileSync(file,"utf8");const anchor="const dirty=Boolean(await observers[sink]";if(text.split(anchor).length-1!==2)throw new Error("observer anchors not exact");text=text.split(anchor).join("const dirty=false /* D3_CANARY_OBSERVER_NEUTERED */&&Boolean(await observers[sink]");fs.writeFileSync(file,text);
}else throw new Error("unknown canary variant");
NODE
}
capture_d2(){ local module="$1" pattern="$2" log="$3"; run_d2 "$module" "$pattern" >"$log" 2>&1; return $?; }
capture_w1_7(){ local module="$1" pattern="$2" log="$3"; run_w1_7 "$module" "$pattern" >"$log" 2>&1; return $?; }
mapfile -t MUTATIONS < <(cat "$root_dir/tests/failure/d1-mutations.txt" "$root_dir/tests/failure/d2-mutations.txt" "$root_dir/tests/failure/d3-mutations.txt")
if [ "${1:-}" = "--negative" ]; then MUTATIONS=("NOOP|SELECT 1;|SELECT false"); fi
executed=0
for line in "${MUTATIONS[@]}"; do
  IFS='|' read -r name mutation check <<< "$line"
  if [ "$mutation" = D2_MODULE_SUBSTITUTION ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; variant="$mutation_dir/substitution.mjs"; pattern="substitution"
    base=$(assert_d2 "$source_module" "$pattern")
    make_d2_variant "$variant" substitution || { fail=1; continue; }
    if grep -Fq '[request.principalId ?? session.principalId]' "$variant"; then applied=t; else applied=f; fi
    log="$mutation_dir/substitution.log"; capture_d2 "$variant" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'D2_SUBSTITUTION minted_by=22000000-0000-0000-0000-000000000002 tenant=20000000-0000-0000-0000-000000000002' "$log" && forbidden=t
    restored=$(assert_d2 "$source_module" "$pattern")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D2_MODULE_JOINT_LEAK ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; pattern="joint"
    local_variant="$mutation_dir/local-false.mjs"; scrub_variant="$mutation_dir/no-scrub.mjs"; joint_variant="$mutation_dir/joint.mjs"
    base=$(assert_d2 "$source_module" "$pattern")
    make_d2_variant "$local_variant" local_false || { fail=1; continue; }; local_only=$(assert_d2 "$local_variant" "$pattern")
    make_d2_variant "$scrub_variant" no_scrub || { fail=1; continue; }; scrub_only=$(assert_d2 "$scrub_variant" "$pattern")
    make_d2_variant "$joint_variant" joint || { fail=1; continue; }
    if grep -Fq "set_config('app.principal_id', \$1, false)" "$joint_variant" && ! grep -Fq 'client.query("DISCARD ALL")' "$joint_variant"; then applied=t; else applied=f; fi
    log="$mutation_dir/joint.log"; capture_d2 "$joint_variant" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'D2_JOINT_LEAK module_checkout="11000000-0000-0000-0000-000000000001"' "$log" && forbidden=t
    restored=$(assert_d2 "$source_module" "$pattern")
    printf '%s baseline=%s local_only=%s scrub_only=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$local_only" "$scrub_only" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$local_only" = 0 ] && [ "$scrub_only" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D2_MODULE_ROLE_GUARD ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; variant="$mutation_dir/role.mjs"; pattern="role"
    base=$(assert_d2 "$source_module" "$pattern")
    make_d2_variant "$variant" role || { fail=1; continue; }
    if ! grep -Fq 'SESSION_ROLE_INVALID' "$variant"; then applied=t; else applied=f; fi
    log="$mutation_dir/role.log"; capture_d2 "$variant" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'D2_ROLE_GUARD maintenance=accepted app=' "$log" && grep -Fq 'postgres=accepted' "$log" && forbidden=t
    restored=$(assert_d2 "$source_module" "$pattern")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D2_MODULE_DIRTY_RELEASE ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; fault_variant="$mutation_dir/dirty-fault.mjs"; weak_variant="$mutation_dir/dirty-weakened.mjs"; pattern="dirty-success"
    base=$(assert_d2 "$source_module" "$pattern")
    make_d2_variant "$fault_variant" dirty_fault || { fail=1; continue; }
    fault_log="$mutation_dir/dirty-fault.log"; capture_d2 "$fault_variant" "$pattern" "$fault_log"; fault_only=$?
    fault_clean=f; grep -Fq 'principal=""' "$fault_log" && fault_clean=t
    make_d2_variant "$weak_variant" dirty_weakened || { fail=1; continue; }
    if grep -Fq 'client.query("DISCARD ALLXX")' "$weak_variant" && grep -Fq 'client.release()' "$weak_variant"; then applied=t; else applied=f; fi
    log="$mutation_dir/dirty-weakened.log"; capture_d2 "$weak_variant" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'principal="11000000-0000-0000-0000-000000000001"' "$log" && forbidden=t
    restored=$(assert_d2 "$source_module" "$pattern")
    printf '%s baseline=%s fault_only=%s fault_clean=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$fault_only" "$fault_clean" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$fault_only" = 0 ] && [ "$fault_clean" = t ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D3_MODULE_ROLLBACK_MINT ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; variant="$mutation_dir/d3-rollback-mint.mjs"; pattern="atomic"
    base=$(assert_w1_7 "$source_module" "$pattern")
    make_d2_variant "$variant" rollback_mint || { fail=1; continue; }
    if grep -Fq '      await client.query("ROLLBACK");' "$variant"; then applied=t; else applied=f; fi
    log="$mutation_dir/d3-rollback-mint.log"; capture_w1_7 "$variant" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'W1_7_DURABLE_ATOMIC custody=0 references=0 audit=0 canonical=true' "$log" && forbidden=t
    restored=$(assert_w1_7 "$source_module" "$pattern")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D3_MODULE_SWALLOW_REFUSAL ]; then
    build || { fail=1; continue; }
    psql_as postgres "$SDB" -c "DELETE FROM founder_authorities WHERE principal_id='22000000-0000-0000-0000-000000000002';" >/dev/null || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; variant="$mutation_dir/d3-swallow-refusal.mjs"; pattern="authorization"
    base=$(assert_w1_7 "$source_module" "$pattern")
    make_d2_variant "$variant" swallow_refusal || { fail=1; continue; }
    if grep -Fq '01a02095-c806-7000-8000-000000000001' "$variant"; then applied=t; else applied=f; fi
    log="$mutation_dir/d3-swallow-refusal.log"; capture_w1_7 "$variant" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'MINT_AUTHORITY_REFUSED=accepted' "$log" && forbidden=t
    restored=$(assert_w1_7 "$source_module" "$pattern")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D3_DB_WEAKEN_RESOLUTION ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; pattern="resolution"
    base=$(assert_w1_7 "$source_module" "$pattern")
    psql_as postgres "$SDB" -c "DROP POLICY custody_read ON custody_rows; CREATE POLICY custody_read ON custody_rows FOR SELECT USING(true); DROP POLICY reference_read ON minted_references; CREATE POLICY reference_read ON minted_references FOR SELECT USING(true);" >/dev/null || { fail=1; continue; }
    rls_only=$(assert_w1_7 "$source_module" "$pattern")
    build >/dev/null 2>&1 || { fail=1; continue; }
    psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'AND r.tenant_id=t AND r.project_id=p','AND true /* D3_RESOLUTION_ISOLATION_WEAKENED */') WHERE oid='resolve_custody_reference(text)'::regprocedure;" >/dev/null || { fail=1; continue; }
    predicate_only=$(assert_w1_7 "$source_module" "$pattern")
    build >/dev/null 2>&1 || { fail=1; continue; }
    psql_as postgres "$SDB" -c "DROP POLICY custody_read ON custody_rows; CREATE POLICY custody_read ON custody_rows FOR SELECT USING(true); DROP POLICY reference_read ON minted_references; CREATE POLICY reference_read ON minted_references FOR SELECT USING(true); UPDATE pg_proc SET prosrc=replace(prosrc,'AND r.tenant_id=t AND r.project_id=p','AND true /* D3_RESOLUTION_ISOLATION_WEAKENED */') WHERE oid='resolve_custody_reference(text)'::regprocedure;" >/dev/null || { fail=1; continue; }
    applied=$(psql_as postgres "$SDB" -Atc "SELECT (SELECT count(*)=2 FROM pg_policy WHERE polname IN ('custody_read','reference_read') AND pg_get_expr(polqual,polrelid)='true') AND position('D3_RESOLUTION_ISOLATION_WEAKENED' in (SELECT prosrc FROM pg_proc WHERE oid='resolve_custody_reference(text)'::regprocedure))>0" | tr -d '[:space:]')
    log="$mutation_dir/d3-resolution-isolation.log"; capture_w1_7 "$source_module" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'foreign=resolved' "$log" && forbidden=t
    build >/dev/null 2>&1; restored=$(assert_w1_7 "$source_module" "$pattern")
    printf '%s baseline=%s rls_only=%s predicate_only=%s applied=%s combined=%s forbidden=%s restored=%s\n' "$name" "$base" "$rls_only" "$predicate_only" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$rls_only" = 0 ] && [ "$predicate_only" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D3_DB_SKIP_REFERENCE_REVOKE ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; pattern="revocation"
    base=$(assert_w1_7 "$source_module" "$pattern")
    psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'UPDATE minted_references SET revoked_at=revoked_time WHERE reference=p_reference;','PERFORM set_config(''app.d3_mutation'',''D3_REFERENCE_REVOKE_SKIPPED'',true);') WHERE oid='revoke_custody_reference(text)'::regprocedure;" >/dev/null || { fail=1; continue; }
    applied=$(psql_as postgres "$SDB" -Atc "SELECT position('D3_REFERENCE_REVOKE_SKIPPED' in prosrc)>0 AND position('UPDATE minted_references SET revoked_at=revoked_time WHERE reference=p_reference;' in prosrc)=0 FROM pg_proc WHERE oid='revoke_custody_reference(text)'::regprocedure" | tr -d '[:space:]')
    log="$mutation_dir/d3-revocation-atomicity.log"; capture_w1_7 "$source_module" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'clock=false' "$log" && forbidden=t
    [ "$forbidden" = t ] || cat "$log" >&2
    build >/dev/null 2>&1; restored=$(assert_w1_7 "$source_module" "$pattern")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D3_DB_USE_ISSUED_RETENTION_CLOCK ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; pattern="retention"
    base=$(assert_w1_7 "$source_module" "$pattern")
    psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'coalesce(c.rotated_at,c.issued_at)','c.issued_at /* D3_RETENTION_WRONG_CLOCK */') WHERE oid='evaluate_custody_retention(text)'::regprocedure;" >/dev/null || { fail=1; continue; }
    applied=$(psql_as postgres "$SDB" -Atc "SELECT position('D3_RETENTION_WRONG_CLOCK' in prosrc)>0 AND position('coalesce(c.rotated_at,c.issued_at)' in prosrc)=0 FROM pg_proc WHERE oid='evaluate_custody_retention(text)'::regprocedure" | tr -d '[:space:]')
    log="$mutation_dir/d3-retention-clock.log"; capture_w1_7 "$source_module" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'W1_7_DURABLE_RETENTION config=true/true' "$log" && forbidden=t
    [ "$forbidden" = t ] || cat "$log" >&2
    build >/dev/null 2>&1; restored=$(assert_w1_7 "$source_module" "$pattern")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D3_DB_USE_OLD_RETENTION_DURATION ]; then
    build || { fail=1; continue; }
    source_module="$root_dir/packages/git-adapter/src/d2-session-binding.mjs"; pattern="retention"
    base=$(assert_w1_7 "$source_module" "$pattern")
    psql_as postgres "$SDB" -c "UPDATE pg_proc SET prosrc=replace(prosrc,'evaluated-clock_start>=retention_window','evaluated-clock_start>=interval ''400 days'' /* D3_RETENTION_OLD_DURATION */') WHERE oid='evaluate_custody_retention(text)'::regprocedure;" >/dev/null || { fail=1; continue; }
    applied=$(psql_as postgres "$SDB" -Atc "SELECT position('D3_RETENTION_OLD_DURATION' in prosrc)>0 AND position('evaluated-clock_start>=retention_window' in prosrc)=0 FROM pg_proc WHERE oid='evaluate_custody_retention(text)'::regprocedure" | tr -d '[:space:]')
    log="$mutation_dir/d3-retention-duration.log"; capture_w1_7 "$source_module" "$pattern" "$log"; after=$?
    forbidden=f; grep -Fq 'W1_7_DURABLE_RETENTION config=false/true grant=false/true audit=false/true ops=false/false' "$log" && forbidden=t
    [ "$forbidden" = t ] || cat "$log" >&2
    build >/dev/null 2>&1; restored=$(assert_w1_7 "$source_module" "$pattern")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D3_SOURCE_DISABLE_CANARY_DETECTOR ]; then
    source_root="$root_dir"; variant_root="$mutation_dir/canary-detector-disabled"
    base=$(assert_canary "$source_root")
    make_canary_variant "$variant_root" detector_disabled || { fail=1; continue; }
    if grep -Fq 'D3_CANARY_DETECTOR_DISABLED' "$variant_root/packages/git-adapter/src/credential-boundary.mjs" && ! grep -Fq 'if (SECRET.test(v)) return "CREDENTIAL_DETECTED";' "$variant_root/packages/git-adapter/src/credential-boundary.mjs"; then applied=t; else applied=f; fi
    log="$mutation_dir/canary-detector-disabled.log"; run_canary "$variant_root" >"$log" 2>&1; after=$?
    forbidden=f; grep -Fq 'W1_7_CANARY vulnerable_dirty=4/4 protected_clean=0/4 signed=4/4' "$log" && forbidden=t
    [ "$forbidden" = t ] || cat "$log" >&2
    restored=$(assert_canary "$source_root")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = D3_SOURCE_NEUTER_CANARY_OBSERVER ]; then
    source_root="$root_dir"; variant_root="$mutation_dir/canary-observer-neutered"
    base=$(assert_canary "$source_root")
    make_canary_variant "$variant_root" observer_neutered || { fail=1; continue; }
    if [ "$(grep -Fo 'D3_CANARY_OBSERVER_NEUTERED' "$variant_root/packages/git-adapter/src/custody-service.mjs" | wc -l | tr -d '[:space:]')" = 2 ] && ! grep -Fq 'const dirty=Boolean(await observers[sink]' "$variant_root/packages/git-adapter/src/custody-service.mjs"; then applied=t; else applied=f; fi
    log="$mutation_dir/canary-observer-neutered.log"; run_canary "$variant_root" >"$log" 2>&1; after=$?
    forbidden=f; grep -Fq 'W1_7_CANARY vulnerable_dirty=0/4 protected_clean=4/4 signed=4/4' "$log" && forbidden=t
    [ "$forbidden" = t ] || cat "$log" >&2
    restored=$(assert_canary "$source_root")
    printf '%s baseline=%s applied=%s after=%s forbidden=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$forbidden" "$restored"
    executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$forbidden" = t ] && [ "$restored" = 0 ] || fail=1
    continue
  fi
  if [ "$mutation" = FIXTURE_REMOVE_TENANT_CONTEXT ]; then
    build || { fail=1; continue; }
    plant_d1f_residue || { fail=1; continue; }
    guarded=$(assert_file "$root_dir/tests/failure/d1f-controls.sql")
    blind_fixture=$(mktemp)
    awk '!/set_config\('\''app\.tenant_id'\''/' "$root_dir/tests/failure/d1f-controls.sql" > "$blind_fixture"
    if grep -q "set_config('app.tenant_id'" "$blind_fixture"; then applied=f; else applied=t; fi
    blinded=$(assert_file "$blind_fixture")
    restored=$(assert_file "$root_dir/tests/failure/d1f-controls.sql")
    rm -f "$blind_fixture"
    printf '%s guarded=%s applied=%s blinded=%s restored=%s\n' "$name" "$guarded" "$applied" "$blinded" "$restored"
    executed=$((executed+1))
    [ "$guarded" != 0 ] && [ "$applied" = t ] && [ "$blinded" = 0 ] && [ "$restored" != 0 ] || fail=1
    continue
  fi
  build || { fail=1; continue; }
  base=$(assert)
  psql_as postgres "$SDB" -c "$mutation" >/dev/null 2>&1
  applied=$(psql_as postgres "$SDB" -Atc "$check" | tr -d '[:space:]')
  after=$(assert)
  build >/dev/null 2>&1
  restored=$(assert)
  printf '%s baseline=%s applied=%s after=%s restored=%s\n' "$name" "$base" "$applied" "$after" "$restored"
  if [ "$name" = NOOP ]; then [ "$base" = 0 ] && [ "$after" = 0 ] || fail=1; else executed=$((executed+1)); [ "$base" = 0 ] && [ "$applied" = t ] && [ "$after" != 0 ] && [ "$restored" = 0 ] || fail=1; fi
done
if [ "${1:-}" != "--negative" ]; then [ "$executed" = 17 ] || fail=1; fi
if [ "${1:-}" = "--negative" ]; then echo 'NOOP false discrimination correctly rejected' >&2; exit 1; fi
[ "$fail" = 0 ] || { echo 'D1 mutation harness failed' >&2; exit 1; }; echo "D1 mutation harness: all controls discriminate (executed=$executed)"
