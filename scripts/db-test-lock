#!/usr/bin/env bash

db_test_lock_acquire(){
  DB_TEST_LOCK_PATH="${ENGRAMPORT_DB_TEST_LOCK_PATH:-/tmp/engramport-db-test-${UID}.lock}"
  DB_TEST_LOCK_LABEL="${ENGRAMPORT_DB_TEST_LOCK_LABEL:-database test}"
  DB_TEST_LOCK_OWNED=0
  local current holder candidate
  current="$(readlink "$DB_TEST_LOCK_PATH" 2>/dev/null || true)"
  if [[ -n "${ENGRAMPORT_DB_TEST_LOCK_OWNER:-}" && "$current" == "$ENGRAMPORT_DB_TEST_LOCK_OWNER" ]]; then
    return 0
  fi
  candidate="$$:$(date +%s):$RANDOM"
  while ! ln -s "$candidate" "$DB_TEST_LOCK_PATH" 2>/dev/null; do
    current="$(readlink "$DB_TEST_LOCK_PATH" 2>/dev/null || true)"
    holder="${current%%:*}"
    if [[ "$holder" =~ ^[1-9][0-9]*$ ]] && kill -0 "$holder" 2>/dev/null; then
      echo "ENGRAMPORT_DB_TEST_LOCKED: $DB_TEST_LOCK_LABEL refused; active pid=$holder" >&2
      return 75
    fi
    if [[ -z "$current" || "$(readlink "$DB_TEST_LOCK_PATH" 2>/dev/null || true)" != "$current" ]]; then
      echo "ENGRAMPORT_DB_TEST_LOCKED: $DB_TEST_LOCK_LABEL refused; lock owner unreadable" >&2
      return 75
    fi
    rm -f "$DB_TEST_LOCK_PATH"
    echo "ENGRAMPORT_DB_TEST_LOCK_STALE_RECOVERED: prior pid=${holder:-unknown}" >&2
  done
  ENGRAMPORT_DB_TEST_LOCK_OWNER="$candidate";export ENGRAMPORT_DB_TEST_LOCK_OWNER
  DB_TEST_LOCK_OWNED=1
}

db_test_lock_release(){
  [[ "${DB_TEST_LOCK_OWNED:-0}" == 1 ]] || return 0
  local current
  current="$(readlink "$DB_TEST_LOCK_PATH" 2>/dev/null || true)"
  if [[ "$current" == "$ENGRAMPORT_DB_TEST_LOCK_OWNER" ]]; then rm -f "$DB_TEST_LOCK_PATH";fi
  DB_TEST_LOCK_OWNED=0
}

db_test_lock_probe(){
  local ready="${1:-}" release="${2:-}"
  if [[ -z "$ready" || -z "$release" ]]; then echo "lock probe requires READY and RELEASE paths" >&2;return 64;fi
  : > "$ready"
  while [[ ! -e "$release" ]];do sleep 0.05;done
  echo "ENGRAMPORT_DB_TEST_LOCK_PROBE_COMPLETED: $DB_TEST_LOCK_LABEL"
}
