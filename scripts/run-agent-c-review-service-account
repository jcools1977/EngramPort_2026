#!/usr/bin/env node
import { appendFile, mkdir, readdir, readFile, stat, writeFile } from "node:fs/promises";
import os from "node:os";
import path from "node:path";
import { spawn } from "node:child_process";
import { runAgentCWithServiceAccount } from "../packages/agent-c-supervisor/src/index.mjs";
import { decide, ticksSpentOn, utcDay, formatUsd, DEFAULT_DAILY_CAP_TICKS, DEFAULT_RESERVE_TICKS } from "../packages/agent-c-supervisor/src/spend-gate.mjs";

const defaultRoot = path.resolve(import.meta.dirname, "..");

// Which repository to review. agent-c is no longer used only by the project
// that hosts its runner.
const root = process.env.ENGRAMPORT_ROOT
  ? path.resolve(process.env.ENGRAMPORT_ROOT)
  : defaultRoot;

// Which repositories to COUNT spend from. This is deliberately not the same
// list as the one above. The cap is a property of agent-c, not of a repository,
// and deriving spend from only the repository under review would give every new
// repository its own fresh $10/day. A ceiling that multiplies when you add work
// is worse than no ceiling, because it still reads as a ceiling.
//
// So the review root is always ADDED to the default, never substituted for it.
const spendRoots = Array.from(new Set([
  defaultRoot,
  root,
  ...(process.env.ENGRAMPORT_SPEND_ROOTS ?? "").split(":").filter(Boolean).map((p) => path.resolve(p)),
]));
const stateDirectory = path.join(os.homedir(), ".local", "state", "an2b", "engramport-agent-c");
const logFile = path.join(stateDirectory, "runner.log");
const maxLogBytes = 262_144;
const keychainService = "com.an2b.engramport.agent-c.op-service-account";
const keychainAccount = "agent-c";

async function boundedLog(message) {
  await mkdir(stateDirectory, { recursive: true, mode: 0o700 });
  const size = await stat(logFile).then((entry) => entry.size, () => 0);
  if (size > maxLogBytes) {
    const content = await readFile(logFile);
    await writeFile(logFile, content.subarray(content.length - maxLogBytes / 2), { mode: 0o600 });
  }
  await appendFile(logFile, `${new Date().toISOString()} ${message}\n`, { mode: 0o600 });
}

async function notify(message) {
  await new Promise((resolve) => {
    const child = spawn("/usr/bin/osascript", ["-e", `display notification ${JSON.stringify(message)} with title "EngramPort Agent C"`], { stdio: "ignore" });
    child.once("error", resolve);
    child.once("close", resolve);
  });
}

async function readToken() {
  return new Promise((resolve, reject) => {
    const child = spawn("/usr/bin/security", ["find-generic-password", "-a", keychainAccount, "-s", keychainService, "-w"], { stdio: ["ignore", "pipe", "ignore"] });
    let stdout = "";
    child.stdout.on("data", (chunk) => { if (stdout.length < 32_768) stdout += chunk; });
    child.once("error", reject);
    child.once("close", (code) => code === 0 ? resolve(stdout.trim()) : reject(new Error("CREDENTIAL_UNAVAILABLE")));
  });
}

async function invoke(token) {
  const environment = { ...process.env, OP_SERVICE_ACCOUNT_TOKEN: token };
  delete environment.XAI_API_KEY;
  delete environment.OP_CONNECT_HOST;
  delete environment.OP_CONNECT_TOKEN;
  for (const key of Object.keys(environment)) if (key.startsWith("OP_SESSION_")) delete environment[key];
  return new Promise((resolve) => {
    const child = spawn("/opt/homebrew/bin/op", [
      "run",
      `--env-file=${path.join(defaultRoot, "deploy/agent-c.service-account.env.example")}`,
      "--",
      process.execPath,
      path.join(defaultRoot, "scripts/run-agent-c-review"),
      ...process.argv.slice(2)
    ], { cwd: root, env: environment, stdio: "inherit" });
    child.once("error", () => resolve(1));
    child.once("close", (code) => resolve(code ?? 1));
  });
}

const killSwitch = path.join(stateDirectory, "DISABLED");

// One switch that stops every agent in the estate. Three runners previously had
// three separate DISABLED files in three trees, so stopping everything meant
// remembering all three paths. A system you cannot reliably stop is not one you
// can safely leave running.
const globalStop = path.join(os.homedir(), ".local", "state", "an2b", "STOP");

// Spend is derived from the review artifacts the log already carries. A read
// failure refuses the run: "I cannot tell what I have spent today" must never
// be treated as "I have spent nothing".
async function spentTicksToday() {
  const rows = [];
  let sawAny = false;
  for (const base of spendRoots) {
    const dir = path.join(base, "artifacts/agent-c/reviews");
    const names = await readdir(dir).catch(() => null);
    // A root with no reviews directory contributes nothing and is not a fault:
    // a newly created repository legitimately has none yet.
    if (names === null) continue;
    sawAny = true;
    for (const name of names.filter((n) => n.endsWith(".json"))) {
      const relative = path.join(base, "artifacts/agent-c/reviews", name);
      try {
        rows.push({ relative, review: JSON.parse(await readFile(path.join(dir, name), "utf8")) });
      } catch {
        return null;
      }
    }
  }
  if (!sawAny) return null;
  try {
    return ticksSpentOn(rows, utcDay(new Date()));
  } catch {
    return null;
  }
}

const gate = decide({
  disabled: (await stat(globalStop).then(() => true, () => false)) || (await stat(killSwitch).then(() => true, () => false)),
  spentTicks: await spentTicksToday(),
  capTicks: DEFAULT_DAILY_CAP_TICKS,
  reserveTicks: DEFAULT_RESERVE_TICKS,
});

if (!gate.allowed) {
  const detail = gate.spentTicks === undefined
    ? gate.code
    : `${gate.code} spent=${formatUsd(gate.spentTicks)} cap=${formatUsd(gate.capTicks)}`;
  await boundedLog(`REFUSED ${detail}`);
  await notify(`Agent C run refused: ${gate.code}. No provider call was made.`);
  process.exitCode = gate.code === "KILL_SWITCH" ? 0 : 1;
} else {
  await boundedLog(`ALLOWED spent=${formatUsd(gate.spentTicks)} remaining=${formatUsd(gate.remainingTicks)}`);
  const result = await runAgentCWithServiceAccount({ readToken, invoke, log: boundedLog, notify });
  if (result.status === "failed") process.exitCode = 1;
}

