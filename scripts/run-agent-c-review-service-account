#!/usr/bin/env node
import { appendFile, mkdir, readFile, stat, writeFile } from "node:fs/promises";
import os from "node:os";
import path from "node:path";
import { spawn } from "node:child_process";
import { runAgentCWithServiceAccount } from "../packages/agent-c-supervisor/src/index.mjs";

const root = path.resolve(import.meta.dirname, "..");
const stateDirectory = path.join(os.homedir(), ".local", "state", "an2b", "engramport-agent-c");
const logFile = path.join(stateDirectory, "runner.log");
const maxLogBytes = 262_144;
const keychainService = "com.an2b.engramport.agent-c.op-service-account";
const keychainAccount = "agent-c";

async function boundedLog(message) {
  await mkdir(stateDirectory, { recursive: true, mode: 0o700 });
  const size = await stat(logFile).then((entry) => entry.size, () => 0);
  if (size > maxLogBytes) {
    const content = await readFile(logFile);
    await writeFile(logFile, content.subarray(content.length - maxLogBytes / 2), { mode: 0o600 });
  }
  await appendFile(logFile, `${new Date().toISOString()} ${message}\n`, { mode: 0o600 });
}

async function notify(message) {
  await new Promise((resolve) => {
    const child = spawn("/usr/bin/osascript", ["-e", `display notification ${JSON.stringify(message)} with title "EngramPort Agent C"`], { stdio: "ignore" });
    child.once("error", resolve);
    child.once("close", resolve);
  });
}

async function readToken() {
  return new Promise((resolve, reject) => {
    const child = spawn("/usr/bin/security", ["find-generic-password", "-a", keychainAccount, "-s", keychainService, "-w"], { stdio: ["ignore", "pipe", "ignore"] });
    let stdout = "";
    child.stdout.on("data", (chunk) => { if (stdout.length < 32_768) stdout += chunk; });
    child.once("error", reject);
    child.once("close", (code) => code === 0 ? resolve(stdout.trim()) : reject(new Error("CREDENTIAL_UNAVAILABLE")));
  });
}

async function invoke(token) {
  const environment = { ...process.env, OP_SERVICE_ACCOUNT_TOKEN: token };
  delete environment.XAI_API_KEY;
  delete environment.OP_CONNECT_HOST;
  delete environment.OP_CONNECT_TOKEN;
  for (const key of Object.keys(environment)) if (key.startsWith("OP_SESSION_")) delete environment[key];
  return new Promise((resolve) => {
    const child = spawn("/opt/homebrew/bin/op", [
      "run",
      "--env-file=./deploy/agent-c.service-account.env.example",
      "--",
      process.execPath,
      "scripts/run-agent-c-review",
      ...process.argv.slice(2)
    ], { cwd: root, env: environment, stdio: "inherit" });
    child.once("error", () => resolve(1));
    child.once("close", (code) => resolve(code ?? 1));
  });
}

const result = await runAgentCWithServiceAccount({ readToken, invoke, log: boundedLog, notify });
if (result.status === "failed") process.exitCode = 1;
