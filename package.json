{
  "name": "engramport",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run proof && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "engram": "node scripts/engram",
    "proof:verify": "node scripts/verify-log",
    "proof:test": "node --test tests/git-v0.test.mjs",
    "proof": "npm run proof:verify && npm run proof:test"
    ,"db:test": "bash scripts/run-db-tests"
    ,"welcome:test": "node --test tests/welcome-package.test.mjs"
    ,"setup:test": "node --test tests/workspace-setup*.test.mjs"
    ,"watch:test": "node --test tests/port-watch.test.mjs"
    ,"db:static-test": "node --test tests/app-role-grants-static.test.mjs"
    ,"dispatch:test": "node --test tests/workspace-dispatch-gate.test.mjs"
    ,"w1-6:test": "node --test tests/wizard-w1-6.test.mjs"
    ,"w1-7:test": "node --test tests/wizard-w1-7.test.mjs"
    ,"dry-run:test": "node --test tests/workspace-dry-run.test.mjs"
    ,"session:test": "node --test tests/workspace-session.test.mjs"
    ,"approval:test": "node --test tests/workspace-approval.test.mjs"
    ,"report:test": "node --test tests/report-boundary.test.mjs"
    ,"report:r2:test": "node --test tests/report-r2.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
