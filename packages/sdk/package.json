{
  "name": "@engramport/sdk",
  "version": "0.5.0",
  "description": "Coordination substrate for several builders' agents: an append-only, verifiable event log, with the shared turn decision that bounds an autonomous agent.",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "coordination",
    "event-sourcing",
    "provenance",
    "git"
  ],
  "homepage": "https://engramport.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcools1977/EngramPort_2026.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "bin": {
    "engram": "dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --config vite.config.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
